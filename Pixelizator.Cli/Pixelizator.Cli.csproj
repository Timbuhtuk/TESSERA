<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tessera</AssemblyName>
    <Product>Tessera</Product>
    <AssemblyTitle>Tessera CLI</AssemblyTitle>
    <RootNamespace>Pixelizator.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Compile Include="..\DomainColorTest\MoodboardPngExporter.cs" Link="MoodboardPngExporter.cs" />
    <ProjectReference Include="..\PixelArtDownscale\PixelArtDownscale.csproj" />
    <ProjectReference Include="..\PixelArtAlignment\PixelArtAlignment.csproj" />
    <ProjectReference Include="..\PixelArtAseprite\PixelArtAseprite.csproj" />
    <ProjectReference Include="..\PixelArtWorkflows\PixelArtWorkflows.csproj" />
    <InternalsVisibleTo Include="Pixelizator.Cli.Tests" />
  </ItemGroup>
</Project>
