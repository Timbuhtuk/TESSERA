        <ScrollViewer x:Name="homeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="HomeScrolled">
            <StackPanel x:Name="homeContent" Margin="32,8,32,24">
                <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True">
                    <Grid x:Name="heroPanel" Height="250" Background="{DynamicResource Ts.Canvas}" MouseMove="HeroMouseMove" MouseLeave="HeroMouseLeave">
                        <Image Source="Assets/landscape.png" Stretch="UniformToFill" Opacity="0.85" Margin="-18" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False">
                            <Image.RenderTransform><TranslateTransform x:Name="landscapeOffset" /></Image.RenderTransform>
                        </Image>
                        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Ts.HeroScrim}" />
                        <Rectangle x:Name="heroCompactScrim" IsHitTestVisible="False" Fill="{DynamicResource Ts.Canvas}" Opacity="0.76" Visibility="Collapsed" />
                        <StackPanel x:Name="heroCopy" Margin="32,28" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="520">
                            <TextBlock x:Name="heroTitle" Text="{local:Translate TextE1A8A8A5E0C4}" Style="{StaticResource DisplayTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate Text0BF15C061D89}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" LineHeight="23" />
                            <Button x:Name="homeOpenButton" Content="{local:Translate Text3081637D6021}" Style="{StaticResource PrimaryButton}" Click="HomeOpenImage" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" ToolTip="{local:Translate TextFB5661CD199F}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="asepriteBanner" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True" Margin="0,16,0,0" Background="{DynamicResource Ts.Raised}">
                    <Grid MinHeight="220">
                        <Border x:Name="asepriteBannerArt" Width="440" Height="190" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0" IsHitTestVisible="False" Opacity="0.85" RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/animation-banner.png" Viewbox="0.36,0.19,0.64,0.55" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform" />
                            </Border.Background>
                        </Border>
                        <StackPanel x:Name="asepriteBannerCopy" Margin="32,28" MaxWidth="500" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock x:Name="asepriteBannerTitle" Text="{local:Translate Text46F655DF7238}" Style="{StaticResource DisplayTitle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate Text4AC8B527DE9F}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" TextWrapping="Wrap" />
                            <Button x:Name="homeAsepriteButton" Content="{local:Translate Text8A04EAA0CFBD}" Click="OpenAsepriteWorkspace" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="backgroundBanner" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True" Margin="0,16,0,0" Background="{DynamicResource Ts.Raised}">
                    <Grid Height="220">
                        <StackPanel x:Name="backgroundBannerArt" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,46,0" IsHitTestVisible="False">
                            <Border Width="126" Height="126" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Background="{DynamicResource Ts.TextSecondary}">
                                <TextBlock Text="T" FontFamily="{StaticResource UiFont}" FontWeight="Black" FontSize="100" Foreground="{DynamicResource Ts.Raised}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="→" FontSize="34" Foreground="{DynamicResource Ts.TextMuted}" VerticalAlignment="Center" Margin="22,0" />
                            <Border Width="126" Height="126" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1">
                                <Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing><DrawingGroup>
                                        <GeometryDrawing Brush="{DynamicResource Ts.Panel}" Geometry="M0,0 H20 V20 H0 Z" />
                                        <GeometryDrawing Brush="{DynamicResource Ts.Hover}" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z" />
                                    </DrawingGroup></DrawingBrush.Drawing>
                                </DrawingBrush></Border.Background>
                                <TextBlock Text="T" FontFamily="{StaticResource UiFont}" FontWeight="Black" FontSize="100" Foreground="{DynamicResource Ts.Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="backgroundBannerCopy" Margin="32,28" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="500">
                            <TextBlock x:Name="backgroundBannerTitle" Text="{local:Translate Text3F3E245106F1}" Style="{StaticResource DisplayTitle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate Text667EAE1E40EE}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" TextWrapping="Wrap" />
                            <Button x:Name="homeBackgroundButton" Content="{local:Translate Text87142769BA12}" Click="OpenBackgroundWorkspace" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="iconBanner" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True" Margin="0,16,0,0" Background="{DynamicResource Ts.Raised}">
                    <Grid Height="220">
                        <StackPanel x:Name="iconBannerArt" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,46,0" IsHitTestVisible="False" Opacity="0.7">
                            <Image Source="Assets/app-icon.png" Width="32" Height="32" Margin="0,70,22,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Image Source="Assets/app-icon.png" Width="64" Height="64" Margin="0,38,22,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Border BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Padding="10"><Image Source="Assets/app-icon.png" Width="128" Height="128" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Border>
                        </StackPanel>
                        <StackPanel x:Name="iconBannerCopy" Margin="32,28" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock x:Name="iconBannerTitle" Text="{local:Translate Text08836605DFFE}" Style="{StaticResource DisplayTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate Text036D088C4248}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" TextWrapping="Wrap" />
                            <Button x:Name="homeIconButton" Content="{local:Translate Text7790C1666B08}" Click="OpenIconWorkspace" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="moodboardBanner" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True" Margin="0,16,0,0" Background="{DynamicResource Ts.Raised}">
                    <Grid Height="220">
                        <Canvas x:Name="moodboardBannerArt" Width="340" Height="170" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,55,0" IsHitTestVisible="False">
                            <Border Canvas.Left="20" Canvas.Top="18" Width="176" Height="130" Background="#242424" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" />
                            <Border Canvas.Left="42" Canvas.Top="33" Width="116" Height="84" Background="#8D8D8D" BorderBrush="#E6E6E6" BorderThickness="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-9" /></Border.RenderTransform>
                                <TextBlock Text="T" FontFamily="{StaticResource UiFont}" FontWeight="Black" FontSize="63" Foreground="#202020" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Canvas.Left="166" Canvas.Top="53" Width="127" Height="89" Background="#4B4B4B" BorderBrush="{DynamicResource Ts.TextSecondary}" BorderThickness="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="12" /></Border.RenderTransform>
                                <TextBlock Text="▧" FontSize="65" Foreground="#D0D0D0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Canvas.Left="270" Canvas.Top="27" Width="11" Height="11" Fill="{DynamicResource Ts.Text}" />
                        </Canvas>
                        <StackPanel x:Name="moodboardBannerCopy" Margin="32,28" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="500">
                            <TextBlock x:Name="moodboardBannerTitle" Text="{local:Translate Text1F7ABA1D29D5}" Style="{StaticResource DisplayTitle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate TextCA35FB738618}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" TextWrapping="Wrap" />
                            <Button x:Name="homeMoodboardButton" Content="{local:Translate Text7EC398C0445E}" Click="OpenMoodboardWorkspace" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="tilesBanner" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Margin="0,16,0,0" Background="{DynamicResource Ts.Raised}">
                    <StackPanel Margin="32,28">
                        <TextBlock Text="{local:Translate Text93D68B96996E}" Style="{StaticResource DisplayTitle}" TextWrapping="Wrap" />
                        <TextBlock Text="{local:Translate Text7D575363E173}" Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <Button x:Name="homeTilesButton" Content="{local:Translate Text102635E70A05}" Click="OpenTileInspector" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" />
                    </StackPanel>
                </Border>

                <Grid x:Name="libraryHeading" Margin="0,26,0,18">
                    <TextBlock Text="{local:Translate Text76C1EE2F1BB7}" Style="{StaticResource SectionTitle}" />
                </Grid>
                <Border x:Name="emptyLibrary" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Padding="28" Background="{DynamicResource Ts.Raised}">
                    <StackPanel>
                        <TextBlock Text="{local:Translate Text40BA2656D7BD}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{local:Translate Text691FF355CEE8}" Foreground="{DynamicResource Ts.TextMuted}" FontSize="14" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="libraryCards">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Margin="0,0,12,14" Padding="0" Tag="{Binding}" Click="OpenLibraryCard" HorizontalContentAlignment="Stretch" ToolTip="{local:Translate Text9849A4B07E95}" AutomationProperties.Name="{Binding Label}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="156" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Background="{DynamicResource Ts.Thumbnail}" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="12" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Border>
                                <StackPanel Grid.Row="1" Margin="17">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource Ts.TextMuted}" FontSize="13" Margin="0,9,0,0"><Run Text="{Binding Width, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Height, Mode=OneWay}" /><Run Text="{local:Translate TextFD2A445920B7}" /><Run Text="{Binding Generations.Count, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <local:AsepriteWorkspace x:Name="asepriteWorkspace" Grid.Row="1" Visibility="Collapsed" />
        <local:IconWorkspace x:Name="iconWorkspace" Grid.Row="1" Visibility="Collapsed" />
        <local:BackgroundWorkspace x:Name="backgroundWorkspace" Grid.Row="1" Visibility="Collapsed" />
        <local:MoodboardWorkspace x:Name="moodboardWorkspace" Grid.Row="1" Visibility="Collapsed" />
        <Border Grid.Row="2" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Padding="18,8">
            <DockPanel LastChildFill="True">
                <ProgressBar x:Name="busyIndicator" Width="90" Height="5" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{DynamicResource Ts.Text}" Background="{DynamicResource Ts.Pressed}" IsIndeterminate="True" Visibility="Collapsed" />
                <Button x:Name="updateButton" DockPanel.Dock="Right" Content="{local:Translate Text93B08F7B1465}" Margin="12,0,0,0" Padding="9,2" VerticalAlignment="Center" />
                <TextBlock x:Name="statusLabel" Text="{local:Translate Text3F42086426E9}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
