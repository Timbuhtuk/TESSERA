<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Tessera</Product>
    <AssemblyTitle>Tessera</AssemblyTitle>
    <Description>Tessera — 2D graphics workspace</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <ReleaseNotesFile Condition="'$(ReleaseNotesFile)' == ''">$(MSBuildProjectDirectory)\..\release-notes\catalog.json</ReleaseNotesFile>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Tessera.WpfStyles" Version="0.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PixelArtDownscale\PixelArtDownscale.csproj" />
    <ProjectReference Include="..\PixelArtAlignment\PixelArtAlignment.csproj" />
    <ProjectReference Include="..\PixelArtAseprite\PixelArtAseprite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\settings.svg" />
    <EmbeddedResource Include="Localization\en.json" LogicalName="Tessera.Localization.en.json" />
    <EmbeddedResource Include="$(ReleaseNotesFile)" LogicalName="Tessera.ReleaseNotes.json" />
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\landscape.png" />
    <Resource Include="Assets\palette-preview-photo.png" />
    <Resource Include="Assets\animation-banner.png" />
    <Resource Include="Assets\Fonts\Cascadia-Code-OFL.txt" />
    <Resource Include="Assets\Fonts\Science-Gothic-OFL.txt" />
    <None Include="Assets\Fonts\Cascadia-Code-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\Science-Gothic-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
