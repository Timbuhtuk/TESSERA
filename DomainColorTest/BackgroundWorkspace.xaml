<UserControl x:Class="DomainColorTest.BackgroundWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DomainColorTest"
    Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="backgroundControls">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,0,1" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="backgroundOpenButton" Content="{local:Translate Text0DF7E1837013}" Margin="0,0,7,0"/>
                    <Button x:Name="backgroundSaveButton" Content="{local:Translate Text28C52564AA90}" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                </StackPanel>
                <Button x:Name="backgroundBackButton" Content="←" Width="34" Margin="0,0,10,0" DockPanel.Dock="Left" ToolTip="{local:Translate TextAD94907F6423}" AutomationProperties.Name="{local:Translate TextAD94907F6423}"/>
                <TextBlock Text="{local:Translate Text3F3E245106F1}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
        <Grid x:Name="backgroundContent" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
            <Border x:Name="backgroundSettingsPanel" Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,1,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{local:Translate Text985B5E0F2CCF}" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                        <local:EditorMaterialPicker x:Name="backgroundEditorChoices" Visibility="Collapsed" Margin="0,0,0,12"/>
                        <TextBlock Text="{local:Translate TextC058D95FDDDA}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="backgroundModeInput" SelectedIndex="0" AutomationProperties.Name="{local:Translate TextBE4B7CFCDA6F}" Margin="0,0,0,16">
                            <ComboBoxItem Content="{local:Translate TextEED43C5404C3}"/><ComboBoxItem Content="{local:Translate TextE649FA322395}"/>
                        </ComboBox>
                        <TextBlock Text="{local:Translate Text03449D9A17C3}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="backgroundColorInput" SelectedIndex="0" Margin="0,0,0,16">
                            <ComboBoxItem Content="{local:Translate Text2BC89F591254}"/><ComboBoxItem Content="{local:Translate TextA024A93D4E0C}"/><ComboBoxItem Content="{local:Translate Text1CA9B6B05DFC}"/>
                        </ComboBox>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{local:Translate TextC6F992FFD17B}"/>
                            <TextBlock Text="{Binding Value, ElementName=backgroundToleranceInput, StringFormat={}{0}%}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="backgroundToleranceInput" Minimum="0" Maximum="100" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutomationProperties.Name="{local:Translate Text0C4B88F7B78A}"/>
                        <TextBlock Text="{local:Translate TextD5EB20A84E74}" Style="{StaticResource Hint}"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,12"/>
                        <TextBlock x:Name="backgroundFileLabel" Foreground="{DynamicResource Ts.TextMuted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="backgroundPreviewScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="backgroundPreviewGrid" Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="backgroundSourcePanel">
                        <TextBlock Text="{local:Translate Text1EB3278B5211}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Thumbnail}" Height="355">
                            <local:PixelPreview x:Name="backgroundSourcePreview" EmptyText="{local:Translate Text73C0387A0340}" PreviewBackground="0"/>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="backgroundResultPanel" Grid.Column="2">
                        <TextBlock Text="{local:Translate Text5839549C1984}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Thumbnail}" Height="355">
                            <local:PixelPreview x:Name="backgroundResultPreview" EmptyText="{local:Translate TextA3415B62A5D0}" PreviewBackground="0"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>