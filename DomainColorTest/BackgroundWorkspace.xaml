<UserControl x:Class="DomainColorTest.BackgroundWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DomainColorTest"
    Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="backgroundControls">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="backgroundOpenButton" Content="Открыть…" Margin="0,0,7,0"/>
                    <Button x:Name="backgroundSaveButton" Content="Сохранить PNG…" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                </StackPanel>
                <Button x:Name="backgroundBackButton" Content="←" Width="34" Margin="0,0,10,0" DockPanel.Dock="Left" ToolTip="На главную" AutomationProperties.Name="На главную"/>
                <TextBlock Text="Удаление фона" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
        <Grid x:Name="backgroundContent" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
            <Border x:Name="backgroundSettingsPanel" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Настройки" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                        <local:EditorMaterialPicker x:Name="backgroundEditorChoices" Visibility="Collapsed" Margin="0,0,0,12"/>
                        <TextBlock Text="Способ удаления" Margin="0,0,0,6"/>
                        <ComboBox x:Name="backgroundModeInput" SelectedIndex="0" AutomationProperties.Name="Способ удаления фона" Margin="0,0,0,16">
                            <ComboBoxItem Content="По цвету везде"/><ComboBoxItem Content="От краёв"/>
                        </ComboBox>
                        <TextBlock Text="Цвет фона" Margin="0,0,0,6"/>
                        <ComboBox x:Name="backgroundColorInput" SelectedIndex="0" Margin="0,0,0,16">
                            <ComboBoxItem Content="Авто по краям"/><ComboBoxItem Content="Белый"/><ComboBoxItem Content="Чёрный"/>
                        </ComboBox>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Допуск"/>
                            <TextBlock Text="{Binding Value, ElementName=backgroundToleranceInput, StringFormat={}{0}%}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="backgroundToleranceInput" Minimum="0" Maximum="100" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutomationProperties.Name="Допуск удаления фона"/>
                        <TextBlock Text="0 — точное совпадение. Увеличьте допуск для близких оттенков." Style="{StaticResource Hint}"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,12"/>
                        <TextBlock x:Name="backgroundFileLabel" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="backgroundPreviewScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="backgroundPreviewGrid" Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="backgroundSourcePanel">
                        <TextBlock Text="ИСТОЧНИК" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource ThumbnailBrush}" Height="355">
                            <local:PixelPreview x:Name="backgroundSourcePreview" EmptyText="Перетащите изображение" PreviewBackground="0"/>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="backgroundResultPanel" Grid.Column="2">
                        <TextBlock Text="РЕЗУЛЬТАТ" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource ThumbnailBrush}" Height="355">
                            <local:PixelPreview x:Name="backgroundResultPreview" EmptyText="Результат появится здесь" PreviewBackground="0"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>