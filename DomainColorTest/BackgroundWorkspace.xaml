<UserControl x:Class="DomainColorTest.BackgroundWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DomainColorTest" Background="#101010" Foreground="#EEEEEE">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="backgroundContent" Margin="32,16,32,32">
            <DockPanel Margin="0,0,0,24">
                <Button x:Name="backgroundBackButton" Content="←" Width="34" Height="32" Margin="0,0,14,0" DockPanel.Dock="Left" ToolTip="На главную" AutomationProperties.Name="На главную"/>
                <TextBlock Text="Удаление фона" FontSize="25" FontWeight="SemiBold"/>
            </DockPanel>
            <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#151515" Padding="24">
                <StackPanel x:Name="backgroundControls">
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="backgroundOpenButton" Content="Открыть изображение…" Padding="18,11" Margin="0,0,12,8"/>
                        <Button x:Name="backgroundSaveButton" Content="Сохранить PNG…" Style="{StaticResource PrimaryButton}" Padding="18,11" Margin="0,0,0,8" IsEnabled="False"/>
                    </WrapPanel>
                    <local:EditorMaterialPicker x:Name="backgroundEditorChoices" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,22,12">
                            <TextBlock Text="Способ удаления" Margin="0,0,0,6"/>
                            <ComboBox x:Name="backgroundModeInput" Width="180" SelectedIndex="0" AutomationProperties.Name="Способ удаления фона">
                                <ComboBoxItem Content="По цвету везде"/><ComboBoxItem Content="От краёв"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,22,12">
                            <TextBlock Text="Цвет фона" Margin="0,0,0,6"/>
                            <ComboBox x:Name="backgroundColorInput" Width="180" SelectedIndex="0">
                                <ComboBoxItem Content="Авто по краям"/><ComboBoxItem Content="Белый"/><ComboBoxItem Content="Чёрный"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Width="180" Margin="0,0,0,12">
                            <DockPanel Margin="0,0,0,6"><TextBlock Text="Допуск"/><TextBlock Text="{Binding Value, ElementName=backgroundToleranceInput, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                            <Slider x:Name="backgroundToleranceInput" Minimum="0" Maximum="100" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutomationProperties.Name="Допуск удаления фона"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="backgroundFileLabel" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Grid x:Name="backgroundPreviewGrid" Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="backgroundSourcePanel">
                    <TextBlock Text="Исходник" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#151515" Height="340">
                        <local:PixelPreview x:Name="backgroundSourcePreview" EmptyText="Перетащите изображение" PreviewBackground="0"/>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="backgroundResultPanel" Grid.Column="2">
                    <TextBlock Text="Результат" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#151515" Height="340">
                        <local:PixelPreview x:Name="backgroundResultPreview" EmptyText="Результат появится здесь" PreviewBackground="0"/>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
