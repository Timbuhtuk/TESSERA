<UserControl x:Class="DomainColorTest.EditorMaterialPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DomainColorTest" Foreground="{DynamicResource Ts.Text}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
        <DrawingBrush x:Key="MaterialChecker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource Ts.Panel}" Geometry="M0,0 H16 V16 H0 Z"/>
                <GeometryDrawing Brush="{DynamicResource Ts.Hover}" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
    </ResourceDictionary></UserControl.Resources>
    <Grid>
        <Button x:Name="materialTrigger" Content="{local:Translate Text951B03306A09}" Padding="18,11" AutomationProperties.Name="{local:Translate Text043B0536F028}"/>
        <Popup x:Name="materialPopup" PlacementTarget="{Binding ElementName=materialTrigger}" Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True">
            <Border x:Name="materialPanel" Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Padding="12" MaxWidth="430">
                <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{local:Translate Text550ED2EAF608}" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <WrapPanel x:Name="materialSources"/>
                        <TextBlock x:Name="materialResultsTitle" Text="{local:Translate Text24735A7161D9}" FontSize="14" FontWeight="SemiBold" Margin="2,12,0,8"/>
                        <WrapPanel x:Name="materialResults"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
