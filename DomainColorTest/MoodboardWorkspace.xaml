<UserControl x:Class="DomainColorTest.MoodboardWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DomainColorTest"
    Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,0,1" Padding="10">
            <DockPanel>
                <Button x:Name="backButton" Content="←" Width="34" Margin="0,0,10,0" DockPanel.Dock="Left" ToolTip="{local:Translate TextAD94907F6423}" AutomationProperties.Name="{local:Translate TextAD94907F6423}"/>
                <TextBlock Text="{local:Translate Text1F7ABA1D29D5}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid x:Name="startPanel" Grid.Row="1">
            <Border Width="520" MaxWidth="520" Padding="32" Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{local:Translate TextCCE08FC4B38B}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{local:Translate Text00AFA27669C3}" Style="{StaticResource DisplayTitle}" FontSize="29" TextWrapping="Wrap" Margin="0,10,0,12"/>
                    <TextBlock Text="{local:Translate TextB673DCE937A6}" Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,23"/>
                    <TextBlock Text="{local:Translate Text45B5E94DDEA8}" Margin="0,0,0,6"/>
                    <local:IntegerInput x:Name="widthInput" Minimum="128" Maximum="16384" Value="1200" AutomationProperties.Name="{local:Translate TextD0A49A77ECA7}" Margin="0,0,0,15"/>
                    <TextBlock Text="{local:Translate Text47DCC74F054D}" Margin="0,0,0,6"/>
                    <local:IntegerInput x:Name="heightInput" Minimum="128" Maximum="16384" Value="800" AutomationProperties.Name="{local:Translate Text1C53A3CEC164}" Margin="0,0,0,23"/>
                    <Button x:Name="createButton" Content="{local:Translate Text4EC6105F0630}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="18,11"/>
                    <Button x:Name="openStartButton" Content="{local:Translate Text15DA86BBE7A4}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="editorPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,0,1" Padding="10,8">
                <WrapPanel>
                    <Button x:Name="newButton" Content="{local:Translate Text3541AB764867}" Margin="0,0,7,5"/>
                    <Button x:Name="addButton" Content="{local:Translate TextFA8D5645B9E9}" Margin="0,0,7,5"/>
                    <Button x:Name="saveProjectButton" Content="{local:Translate Text5E5747359318}" Margin="0,0,7,5"/>
                    <Button x:Name="openProjectButton" Content="{local:Translate TextAC90A2895A82}" Margin="0,0,7,5"/>
                    <Button x:Name="exportButton" Content="{local:Translate Text22CA09462870}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,5"/>
                    <ComboBox x:Name="boardZoomInput" SelectedIndex="0" Width="100" Margin="7,0,0,5" ToolTip="{local:Translate TextD62D98EE14CF}" AutomationProperties.Name="{local:Translate Text06BB672ED23D}"><ComboBoxItem Content="{local:Translate Text3681A2658AB5}"/><ComboBoxItem Content="6,25%"/><ComboBoxItem Content="12,5%"/><ComboBoxItem Content="25%"/><ComboBoxItem Content="50%"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/><ComboBoxItem Content="800%"/><ComboBoxItem Content="1600%"/><ComboBoxItem Content="3200%"/><ComboBoxItem Content="6400%"/></ComboBox>
                </WrapPanel>
            </Border>
            <Grid x:Name="editorContent" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <Border x:Name="layersPanel" Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,1,0" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock x:Name="boardSizeLabel" Style="{StaticResource Hint}"/>
                            <TextBlock Text="{local:Translate TextF21CCFACF4CE}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                            <TextBlock Text="{local:Translate Text3E7BA83EB988}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{local:Translate TextEC247034EFDF}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{local:Translate Text03449D9A17C3}" Margin="0,12,0,6"/>
                            <Button x:Name="backgroundColorButton" AutomationProperties.Name="{local:Translate TextB9D7B505D345}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="backgroundSwatch" Width="22" Height="22" Background="White" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="backgroundHex" Text="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <ListBox x:Name="layerList" Height="240" SelectionMode="Extended" AutomationProperties.Name="{local:Translate Text7BE9655E7E9E}" DisplayMemberPath="Name"/>
                            <WrapPanel Margin="0,9,0,14">
                                <Button x:Name="upButton" Content="{local:Translate Text357CCC3E75B9}" Margin="0,0,5,5" ToolTip="{local:Translate Text1797C2A54858}"/>
                                <Button x:Name="downButton" Content="{local:Translate Text443C49DA2A36}" Margin="0,0,5,5" ToolTip="{local:Translate Text0EF4DACE4AF9}"/>
                                <Button x:Name="toFrontButton" Content="{local:Translate Text04B94B1D4875}" Margin="0,0,5,5" ToolTip="{local:Translate TextAB96142AF4BC}"/>
                                <Button x:Name="toBackButton" Content="{local:Translate TextA6E70CC13F6F}" Margin="0,0,5,5" ToolTip="{local:Translate Text617947B7F0A1}"/>
                                <Button x:Name="deleteButton" Content="{local:Translate TextBE99B1361201}" Margin="0,0,5,5" ToolTip="{local:Translate Text30448622C087}"/>
                            </WrapPanel>
                            <TextBlock Text="{local:Translate Text2D4CEA926054}" Margin="0,0,0,5"/>
                            <Slider x:Name="rotationSlider" Minimum="-180" Maximum="180" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{local:Translate TextC7A52FCC6BDF}"/>
                            <TextBlock x:Name="rotationLabel" Text="0°" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,0,0,10"/>
                            <TextBlock Text="{local:Translate Text572095D4A787}" Margin="0,0,0,5"/>
                            <Slider x:Name="scaleSlider" Minimum="10" Maximum="300" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{local:Translate TextF6EB98B43E76}"/>
                            <TextBlock x:Name="scaleLabel" Text="100%" Foreground="{DynamicResource Ts.TextSecondary}"/>
                        </StackPanel>
                    </DockPanel>
                    </ScrollViewer>
                </Border>
                <Grid x:Name="boardArea" Grid.Column="1" Background="{DynamicResource Ts.Canvas}" AllowDrop="True">
                    <ScrollViewer x:Name="boardScroll" Background="{DynamicResource Ts.Canvas}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="Both">
                        <Grid x:Name="boardZoomHost" Background="{DynamicResource Ts.Canvas}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Viewbox x:Name="boardViewbox" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="boardFrame" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Background="White">
                                    <Canvas x:Name="boardSurface" Background="White" ClipToBounds="True" Width="1200" Height="800"/>
                                </Border>
                            </Viewbox>
                        </Grid>
                    </ScrollViewer>
                    <TextBlock x:Name="emptyHint" Text="{local:Translate TextD6F1143E654B}" FontSize="16" Foreground="{DynamicResource Ts.BorderStrong}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
