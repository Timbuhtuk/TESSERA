<Window x:Class="DomainColorTest.TileInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DomainColorTest"
        Title="{local:Translate TextE502CEDA2D88}" Icon="Assets/app.ico"
        Width="1180" Height="800" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}"
        FontFamily="{DynamicResource Ts.UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" PreviewDragOver="FileDragOver" Drop="FileDropped" PreviewKeyDown="WindowKeyDown"
        PreviewKeyUp="WindowKeyUp" Deactivated="WindowDeactivated">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><local:TileInspectorResources/></ResourceDictionary.MergedDictionaries>
        <DrawingBrush x:Key="NeighborChecker" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,16,16">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#3E3E3E" Geometry="M0,0 H16 V16 H0 Z"/>
                <GeometryDrawing Brush="#2E2E2E" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
    </ResourceDictionary></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="inspectorTitle" Text="{local:Translate Text93D68B96996E}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="fileLabel" Text="{local:Translate TextA4957563388D}" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,6,12,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <WrapPanel x:Name="workspaceTileToolbar" Grid.Column="1" VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Right">
                <Button Content="{local:Translate Text6CEEA28AFE13}" Click="OpenCollectionClicked" Margin="0,0,6,6" ToolTip="{local:Translate TextAA6F1DE506E3}"/>
                <Button Content="{local:Translate Text2919A10B9A2A}" Click="SaveCollectionClicked" Margin="0,0,6,6" ToolTip="{local:Translate Text9CDFE08670D1}"/>
                <Button Content="{local:Translate TextA75006C5D7A2}" Click="OpenClicked" Margin="0,0,0,6" ToolTip="{local:Translate TextB324FCF47D3E}"/>
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{local:Translate Text694F0FFED92F}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="assetList" Height="146" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="AssetSelected" AutomationProperties.Name="{local:Translate TextBC36A742FAE5}">
                            <ListBox.ItemTemplate><DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Image Source="{Binding Image}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="{local:Translate Text07CB65087477}" Click="RemoveAssetClicked" Margin="0,0,4,0"/>
                            <Button x:Name="exportButton" Content="PNG…" Click="ExportClicked" IsEnabled="False" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <Button x:Name="importTilesetButton" Content="{local:Translate Text84C7E25A5D80}" Click="OpenTileSetClicked" Margin="0,8,0,0" ToolTip="{local:Translate Text7F9D0F11F37B}"/>
                        <TextBlock Text="{local:Translate Text1A07A205D3E2}" Margin="0,12,0,5"/>
                        <ComboBox x:Name="companionInput" MaxDropDownHeight="340" SelectionChanged="CompanionSelected" AutomationProperties.Name="{local:Translate TextE6D398B72B94}">
                            <ComboBox.ItemTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                                    <Border Width="66" Height="66" BorderThickness="1" BorderBrush="{DynamicResource Ts.Border}" Background="{StaticResource NeighborChecker}">
                                        <Image Source="{Binding DisplayAsset.Image}" Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <TextBlock Text="{Binding Caption}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ts.TextSecondary}"/>
                                </StackPanel>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="pairLabel" Text="{local:Translate Text70033FB0F84C}" Style="{StaticResource Hint}"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,14"/>
                        <TextBlock Text="{local:Translate Text3472342D6716}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="repeatXInput" Content="{local:Translate Text933FF8867862}" IsChecked="True" Click="OptionsChanged"/>
                        <CheckBox x:Name="repeatYInput" Content="{local:Translate Text245019C819B6}" IsChecked="True" Click="OptionsChanged"/>
                        <TextBlock Text="{local:Translate TextFBDC92AE6CF8}" Margin="0,12,0,5"/>
                        <ComboBox x:Name="copiesInput" SelectedIndex="0" SelectionChanged="SelectionChanged" AutomationProperties.Name="{local:Translate Text4FEA157588CE}">
                            <ComboBoxItem Content="3"/><ComboBoxItem Content="5"/><ComboBoxItem Content="7"/>
                        </ComboBox>
                        <TextBlock Text="{local:Translate Text1E06500C00FE}" Margin="0,12,0,5"/>
                        <ComboBox x:Name="zoomInput" SelectedIndex="0" SelectionChanged="SelectionChanged" AutomationProperties.Name="{local:Translate TextCA188CF6DE16}" ToolTip="{local:Translate Text615232E03EF9}">
                            <ComboBoxItem Content="{local:Translate Text3681A2658AB5}"/><ComboBoxItem Content="6,25%"/><ComboBoxItem Content="12,5%"/><ComboBoxItem Content="25%"/><ComboBoxItem Content="50%"/>
                            <ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/><ComboBoxItem Content="800%"/>
                            <ComboBoxItem Content="1600%"/><ComboBoxItem Content="3200%"/><ComboBoxItem Content="6400%"/>
                        </ComboBox>
                        <TextBlock Text="{local:Translate TextA72811DF62D8}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="{local:Translate Text2E118F8CFC37}" Margin="0,12,0,5"/>
                        <ComboBox x:Name="backgroundInput" SelectedIndex="0" SelectionChanged="SelectionChanged" AutomationProperties.Name="{local:Translate Text9D6D5197FC22}">
                            <ComboBoxItem Content="{local:Translate Text5E7EC04C97C5}"/><ComboBoxItem Content="{local:Translate TextA024A93D4E0C}"/><ComboBoxItem Content="{local:Translate Text21943A44634E}"/>
                        </ComboBox>
                        <CheckBox x:Name="guidesInput" Content="{local:Translate Text059662D5BABD}" Click="OptionsChanged" Margin="0,12,0,0"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,16,0,14"/>
                        <CheckBox x:Name="heatInput" Content="{local:Translate TextFE52793B403A}" IsChecked="True" Click="OptionsChanged"
                                  ToolTip="{local:Translate TextF24E0112C0E7}"/>
                        <TextBlock Text="{local:Translate TextD8E51B7BDD60}" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="thresholdLabel" Text="{local:Translate TextDC31C6BFE35D}" Margin="0,12,0,0"/>
                        <Slider x:Name="thresholdInput" Minimum="0" Maximum="30" Value="5" TickFrequency="0.5" ValueChanged="ValueChanged" AutomationProperties.Name="{local:Translate TextE99A389E686A}"/>
                        <TextBlock x:Name="opacityLabel" Text="{local:Translate Text13ADBDD2AE39}"/>
                        <Slider x:Name="opacityInput" Minimum="0" Maximum="100" Value="70" ValueChanged="ValueChanged" AutomationProperties.Name="{local:Translate Text250EB8410223}"/>
                        <TextBlock Text="{local:Translate Text545803916729}" TextWrapping="Wrap"/>
                        <Slider x:Name="stripeInput" Minimum="1" Maximum="8" Value="1" ValueChanged="ValueChanged" AutomationProperties.Name="{local:Translate Text40F68F56621B}"/>
                        <Border Height="8" Margin="0,4,0,6"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#30D250" Offset="0"/><GradientStop Color="#FFD750" Offset="0.5"/><GradientStop Color="#FF3232" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <TextBlock Text="{local:Translate TextC60F395A1648}" Style="{StaticResource Hint}"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,14"/>
                        <CheckBox x:Name="watchInput" Content="{local:Translate Text9E95D6C39340}" IsChecked="True" Click="WatchChanged" ToolTip="{local:Translate TextA4E257CF4A0A}"/>
                        <Button x:Name="reloadButton" Content="{local:Translate Text3B479F67775A}" Click="ReloadClicked" IsEnabled="False" Margin="0,8,0,0"/>
                        <TextBlock Text="{local:Translate Text19D51F0CAA2E}" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
                        <TextBlock Text="{local:Translate TextBB15EEE4CBC7}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="summaryPanel" Grid.Row="2" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Padding="12" Margin="0,10,0,0" Background="{DynamicResource Ts.Raised}">
                    <ScrollViewer x:Name="summaryScroll" MaxHeight="125" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                        <TextBlock x:Name="xSummary" Text="{local:Translate TextA6D2ACC65B31}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ySummary" Text="{local:Translate Text5FA91DBE6450}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel></ScrollViewer>
                </Border>
                <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Padding="8" Margin="0,0,0,10" Background="{DynamicResource Ts.Panel}">
                    <Expander x:Name="editTools" Header="{local:Translate Text9F81FCFA59FF}" IsExpanded="True">
                    <ScrollViewer x:Name="editScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,8,0,0">
                        <WrapPanel>
                            <ComboBox x:Name="paintToolInput" Width="140" SelectedIndex="0" SelectionChanged="PaintToolChanged" Margin="0,0,8,6" AutomationProperties.Name="{local:Translate Text24C8F471724E}">
                                <ComboBoxItem Content="{local:Translate TextF1163738DEB5}"/><ComboBoxItem Content="{local:Translate TextB46D14555E56}"/><ComboBoxItem Content="{local:Translate Text04483A5A1D40}"/><ComboBoxItem Content="{local:Translate TextEB02CFD27F3C}"/>
                            </ComboBox>
                            <TextBox x:Name="paintColorInput" Text="#FFFFFFFF" Width="105" MaxLength="9" Margin="0,0,6,6" AutomationProperties.Name="{local:Translate Text71C13BF9C31A}" ToolTip="{local:Translate Text172CD817B7D7}"/>
                            <Button Content="{local:Translate Text8B26B347A8C6}" Click="ChoosePaintColor" Margin="0,0,8,6"/>
                            <ComboBox x:Name="brushSizeInput" Width="65" SelectedIndex="0" SelectionChanged="SelectionChanged" Margin="0,0,8,6" AutomationProperties.Name="{local:Translate Text715D4040CAAF}">
                                <ComboBoxItem Content="1 px"/><ComboBoxItem Content="2 px"/><ComboBoxItem Content="4 px"/>
                            </ComboBox>
                            <Button x:Name="undoButton" Content="↶" Click="UndoClicked" IsEnabled="False" ToolTip="{local:Translate Text0273B95E0EE7}" AutomationProperties.Name="{local:Translate TextDFC4A6452FC1}" Margin="0,0,4,6"/>
                            <Button x:Name="redoButton" Content="↷" Click="RedoClicked" IsEnabled="False" ToolTip="{local:Translate Text3A8599BD655F}" AutomationProperties.Name="{local:Translate Text12D5AB1441BA}" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="{local:Translate Text32E3B1F59D75}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="smoothPassesInput" Text="1" Width="60" Padding="6,4" Margin="0,0,8,4" AutomationProperties.Name="{local:Translate Text4B7147AD8DFE}"/>
                            <CheckBox x:Name="smoothEdgesInput" Content="{local:Translate TextC3D3E9C503B9}" Click="OptionsChanged" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip="{local:Translate Text6C2CEB0A4321}"/>
                            <Button x:Name="smoothButton" Content="{local:Translate TextC75D41147BEF}" Click="SmoothClicked" IsEnabled="False" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <TextBlock x:Name="editHint" Text="{local:Translate Text27DD5D2DFFB2}" Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel></ScrollViewer>
                    </Expander>
                </Border>
                <Border x:Name="previewPanel" Grid.Row="1" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Thumbnail}" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="previewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="PreviewSizeChanged">
                            <local:TilePreview x:Name="preview" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ScrollViewer>
                        <StackPanel x:Name="onboarding" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="24">
                            <TextBlock Text="{local:Translate Text1D22758F0A4A}" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
                            <TextBlock Text="{local:Translate Text6A3CFA4F1907}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,18"/>
                            <Button Content="{local:Translate TextA75006C5D7A2}" Click="OpenClicked" HorizontalAlignment="Center"/>
                            <TextBlock Text="PNG · BMP · GIF · JPEG · TIFF" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="3" x:Name="pixelLabel" Text="{local:Translate TextE672331C9B16}" Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" MinHeight="36" Margin="0,10,0,0"/>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="statusLabel" Text="{local:Translate TextCA9AD8E6F07A}" Margin="0,12,0,0" Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap"/>
    </Grid>
</Window>
