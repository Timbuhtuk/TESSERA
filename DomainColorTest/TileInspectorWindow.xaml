<Window x:Class="DomainColorTest.TileInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DomainColorTest"
        Title="Проверка тайлинга · TESSERA" Icon="Assets/app.ico"
        Width="1180" Height="800" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}"
        FontFamily="{DynamicResource Ts.UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" PreviewDragOver="FileDragOver" Drop="FileDropped" PreviewKeyDown="WindowKeyDown"
        PreviewKeyUp="WindowKeyUp" Deactivated="WindowDeactivated">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><local:TileInspectorResources/></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="inspectorTitle" Text="Проверка тайлинга" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="fileLabel" Text="Повторение текстуры и проверка противоположных краёв" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,6,12,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <WrapPanel x:Name="workspaceTileToolbar" Grid.Column="1" VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Right">
                <Button Content="Коллекция…" Click="OpenCollectionClicked" Margin="0,0,6,6" ToolTip="Открыть сохранённый проект"/>
                <Button Content="Сохранить проект…" Click="SaveCollectionClicked" Margin="0,0,6,6" ToolTip="Сохранить все ассеты и правки (Ctrl+S)"/>
                <Button Content="Добавить тайлы…" Click="OpenClicked" Margin="0,0,0,6" ToolTip="Добавить изображения (Ctrl+O)"/>
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Коллекция · активный A" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="assetList" Height="146" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="AssetSelected" AutomationProperties.Name="Коллекция тайлов">
                            <ListBox.ItemTemplate><DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Image Source="{Binding Image}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="Убрать" Click="RemoveAssetClicked" Margin="0,0,4,0"/>
                            <Button x:Name="exportButton" Content="PNG…" Click="ExportClicked" IsEnabled="False" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <Button x:Name="importTilesetButton" Content="Импорт тайлсета…" Click="OpenTileSetClicked" Margin="0,8,0,0" ToolTip="Нарезать атлас на отдельные тайлы с ручным или автоматическим подбором сетки"/>
                        <TextBlock Text="Сосед B · тот же размер" Margin="0,12,0,5"/>
                        <ComboBox x:Name="companionInput" DisplayMemberPath="Label" SelectionChanged="CompanionSelected" AutomationProperties.Name="Соседний тайл B"/>
                        <TextBlock x:Name="pairLabel" Text="Сам с собой" Style="{StaticResource Hint}"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,14"/>
                        <TextBlock Text="Повторение" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="repeatXInput" Content="X · слева направо" IsChecked="True" Click="OptionsChanged"/>
                        <CheckBox x:Name="repeatYInput" Content="Y · сверху вниз" IsChecked="True" Click="OptionsChanged"/>
                        <TextBlock Text="Копий по включённой оси" Margin="0,12,0,5"/>
                        <ComboBox x:Name="copiesInput" SelectedIndex="0" SelectionChanged="SelectionChanged" AutomationProperties.Name="Количество повторений">
                            <ComboBoxItem Content="3"/><ComboBoxItem Content="5"/><ComboBoxItem Content="7"/>
                        </ComboBox>
                        <TextBlock Text="Масштаб · без сглаживания" Margin="0,12,0,5"/>
                        <ComboBox x:Name="zoomInput" SelectedIndex="0" SelectionChanged="SelectionChanged" AutomationProperties.Name="Масштаб тайла">
                            <ComboBoxItem Content="Вписать"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/>
                            <ComboBoxItem Content="400%"/><ComboBoxItem Content="800%"/><ComboBoxItem Content="1600%"/><ComboBoxItem Content="3200%"/>
                        </ComboBox>
                        <TextBlock Text="Фон прозрачности" Margin="0,12,0,5"/>
                        <ComboBox x:Name="backgroundInput" SelectedIndex="0" SelectionChanged="SelectionChanged" AutomationProperties.Name="Фон предпросмотра">
                            <ComboBoxItem Content="Шахматка"/><ComboBoxItem Content="Белый"/><ComboBoxItem Content="Тёмный"/>
                        </ComboBox>
                        <CheckBox x:Name="guidesInput" Content="Границы тайлов" Click="OptionsChanged" Margin="0,12,0,0"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,16,0,14"/>
                        <CheckBox x:Name="heatInput" Content="Тепловая карта краёв" IsChecked="True" Click="OptionsChanged"
                                  ToolTip="Удерживайте Alt, чтобы временно показать тепловую карту. Отпустите Alt, чтобы вернуть выбранный режим."/>
                        <TextBlock Text="Удерживайте Alt для временного показа" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="thresholdLabel" Text="Порог различия Δ: 5,0" Margin="0,12,0,0"/>
                        <Slider x:Name="thresholdInput" Minimum="0" Maximum="30" Value="5" TickFrequency="0.5" ValueChanged="ValueChanged" AutomationProperties.Name="Порог цветового различия"/>
                        <TextBlock x:Name="opacityLabel" Text="Непрозрачность: 70%"/>
                        <Slider x:Name="opacityInput" Minimum="0" Maximum="100" Value="70" ValueChanged="ValueChanged" AutomationProperties.Name="Непрозрачность тепловой карты"/>
                        <TextBlock Text="Ширина полосы · пиксели исходника" TextWrapping="Wrap"/>
                        <Slider x:Name="stripeInput" Minimum="1" Maximum="8" Value="1" ValueChanged="ValueChanged" AutomationProperties.Name="Ширина тепловой полосы"/>
                        <Border Height="8" Margin="0,4,0,6"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#30D250" Offset="0"/><GradientStop Color="#FFD750" Offset="0.5"/><GradientStop Color="#FF3232" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <TextBlock Text="Зелёный ≤ порога · красный ≥ 4× порога. При пороге 0 красный от Δ=1." Style="{StaticResource Hint}"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,14"/>
                        <CheckBox x:Name="watchInput" Content="Следить за файлом" IsChecked="True" Click="WatchChanged" ToolTip="Обновлять после сохранения во внешнем редакторе"/>
                        <Button x:Name="reloadButton" Content="Перечитать файл" Click="ReloadClicked" IsEnabled="False" Margin="0,8,0,0"/>
                        <TextBlock Text="Δ = расстояние OKLab × 100. Прозрачность сравнивается на чёрном и белом фоне; берётся большее различие. Анализируются крайние строки и столбцы." Style="{StaticResource Hint}" Margin="0,14,0,0"/>
                        <TextBlock Text="Совпадение краёв — подсказка. Ритм рисунка и заметность шва оценивайте по повторению." Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="summaryPanel" Grid.Row="2" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Padding="12" Margin="0,10,0,0" Background="{DynamicResource Ts.Raised}">
                    <ScrollViewer x:Name="summaryScroll" MaxHeight="125" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                        <TextBlock x:Name="xSummary" Text="X · нет изображения" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ySummary" Text="Y · нет изображения" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel></ScrollViewer>
                </Border>
                <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Padding="8" Margin="0,0,0,10" Background="{DynamicResource Ts.Panel}">
                    <Expander x:Name="editTools" Header="Рисование и сглаживание" IsExpanded="True">
                    <ScrollViewer x:Name="editScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,8,0,0">
                        <WrapPanel>
                            <ComboBox x:Name="paintToolInput" Width="140" SelectedIndex="0" SelectionChanged="PaintToolChanged" Margin="0,0,8,6" AutomationProperties.Name="Инструмент рисования">
                                <ComboBoxItem Content="Просмотр"/><ComboBoxItem Content="Карандаш"/><ComboBoxItem Content="Ластик"/><ComboBoxItem Content="Пипетка"/>
                            </ComboBox>
                            <TextBox x:Name="paintColorInput" Text="#FFFFFFFF" Width="105" MaxLength="9" Margin="0,0,6,6" AutomationProperties.Name="Цвет карандаша HEX" ToolTip="#RRGGBB или #AARRGGBB"/>
                            <Button Content="Цвет…" Click="ChoosePaintColor" Margin="0,0,8,6"/>
                            <ComboBox x:Name="brushSizeInput" Width="65" SelectedIndex="0" SelectionChanged="SelectionChanged" Margin="0,0,8,6" AutomationProperties.Name="Размер кисти">
                                <ComboBoxItem Content="1 px"/><ComboBoxItem Content="2 px"/><ComboBoxItem Content="4 px"/>
                            </ComboBox>
                            <Button x:Name="undoButton" Content="↶" Click="UndoClicked" IsEnabled="False" ToolTip="Отменить (Ctrl+Z)" AutomationProperties.Name="Отменить правку" Margin="0,0,4,6"/>
                            <Button x:Name="redoButton" Content="↷" Click="RedoClicked" IsEnabled="False" ToolTip="Повторить (Ctrl+Y)" AutomationProperties.Name="Повторить правку" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Проходов 3×3" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="smoothPassesInput" Text="1" Width="60" Padding="6,4" Margin="0,0,8,4" AutomationProperties.Name="Число проходов сглаживания"/>
                            <CheckBox x:Name="smoothEdgesInput" Content="Только края" Click="OptionsChanged" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip="Ширина полосы задаётся шириной тепловой карты"/>
                            <Button x:Name="smoothButton" Content="Сгладить цвета A" Click="SmoothClicked" IsEnabled="False" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <TextBlock x:Name="editHint" Text="Рисование — по выбранной копии A или B; сглаживание и отмена — для активного A." Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel></ScrollViewer>
                    </Expander>
                </Border>
                <Border x:Name="previewPanel" Grid.Row="1" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Thumbnail}" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="previewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="PreviewSizeChanged">
                            <local:TilePreview x:Name="preview" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ScrollViewer>
                        <StackPanel x:Name="onboarding" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="24">
                            <TextBlock Text="Проверьте стыки" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
                            <TextBlock Text="Добавьте пиксельные тайлы в коллекцию. Выберите активный A и сосед B, включите X / Y. Коллекция и правки сохраняются в проект." TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,18"/>
                            <Button Content="Добавить тайлы…" Click="OpenClicked" HorizontalAlignment="Center"/>
                            <TextBlock Text="PNG · BMP · GIF · JPEG · TIFF" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="3" x:Name="pixelLabel" Text="Наведите курсор на тайл, чтобы увидеть Δ для строки и столбца." Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" MinHeight="36" Margin="0,10,0,0"/>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="statusLabel" Text="Готово · Ctrl+O — открыть изображение" Margin="0,12,0,0" Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap"/>
    </Grid>
</Window>
