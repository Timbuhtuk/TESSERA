<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Tessera.WpfStyles;component/Themes/TesseraTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Compatibility names for application-specific XAML. Values come from Tessera.WpfStyles. -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Tessera.WpfStyles;component/Fonts/#Cascadia Code</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Tessera.WpfStyles;component/Fonts/#Science Gothic</FontFamily>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Ts.CanvasColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource Ts.RaisedColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Ts.PanelColor}" />
    <SolidColorBrush x:Key="ThumbnailBrush" Color="{StaticResource Ts.ThumbnailColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Ts.BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource Ts.BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Ts.TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Ts.TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Ts.TextMutedColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource Ts.HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource Ts.PressedColor}" />

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="Background" Value="{DynamicResource Ts.Canvas}" />
        <Setter Property="Foreground" Value="{DynamicResource Ts.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ts.UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DisplayTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.HeroText}" />
    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.SectionText}" />
    <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.CardTitleText}" />
    <Style x:Key="TechnicalText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.MutedText}" />
    <Style x:Key="Hint" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.MutedText}">
        <Setter Property="Margin" Value="0,5,0,8" />
    </Style>
    <Style x:Key="Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.MutedText}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,10" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Ts.HeroButton}" />

    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="50" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Margin" Value="0,5,0,8" />
    </Style>

    <Style x:Key="RemoveThumbnailButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Ts.CompactButton}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="#E6101010" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1">
                        <Path Data="M 0,0 L 7,7 M 7,0 L 0,7" Width="8" Height="8" Stretch="Fill"
                              Stroke="{DynamicResource Ts.Text}" StrokeThickness="1.4"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ts.Pressed}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="White" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ts.Focus}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#333333" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModeButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource Ts.Text}" />
        <Setter Property="Background" Value="{DynamicResource Ts.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ts.Border}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ts.UiFont}" />
        <Setter Property="Margin" Value="0,0,4,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ts.Pressed}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ts.TextSecondary}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ts.Hover}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ts.Focus}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ts.Focus}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolExpander" TargetType="{x:Type Expander}" BasedOn="{StaticResource {x:Type Expander}}" />

    <Style x:Key="CaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="39" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#DADADA" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Ts.Hover}" /><Setter Property="Foreground" Value="White" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Ts.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Ts.Pressed}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MaximizeCaptionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="ToolTip" Value="Развернуть" />
        <Setter Property="AutomationProperties.Name" Value="Развернуть" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="ToolTip" Value="Восстановить" />
                <Setter Property="AutomationProperties.Name" Value="Восстановить" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Ts.Text}" /><Setter Property="Foreground" Value="{DynamicResource Ts.Canvas}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Ts.Text}" /><Setter Property="Foreground" Value="{DynamicResource Ts.Canvas}" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>