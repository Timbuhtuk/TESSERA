<Window x:Class="DomainColorTest.ReleaseNotesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DomainColorTest"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Width="680" Height="560" MinWidth="440" MinHeight="360" WindowStartupLocation="CenterOwner"
    WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Icon="Assets/app.ico"
    Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}" FontFamily="{DynamicResource Ts.UiFont}"
    UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="NotesKeyDown">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><local:AppearanceResources /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Border Background="{DynamicResource Ts.Canvas}" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Background="{DynamicResource Ts.Raised}">
                <Button x:Name="closeNotesButton" DockPanel.Dock="Right" Content="×" Style="{StaticResource CloseCaptionButton}" Click="CloseNotes" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <TextBlock x:Name="notesTitle" Margin="16,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <local:ReleaseNotesView x:Name="notesView" Grid.Row="1" Margin="20,20,20,0" />
            <DockPanel Grid.Row="2" Margin="20,12,20,20" LastChildFill="True">
                <Button x:Name="continueButton" DockPanel.Dock="Right" Padding="18,8" Click="CloseNotes" IsDefault="True" />
                <TextBlock x:Name="saveWarning" Visibility="Collapsed" Foreground="{DynamicResource Ts.TextMuted}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
