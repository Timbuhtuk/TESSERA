<UserControl x:Class="DomainColorTest.WorkspaceBrowser"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:DomainColorTest" AllowDrop="True">
 <UserControl.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource Ts.CompactButton}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,2"/>
  </Style>
  <Style TargetType="TreeViewItem">
   <Setter Property="Foreground" Value="{DynamicResource Ts.Text}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
     <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="HeaderFrame" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" MinHeight="28">
      <ContentPresenter x:Name="PART_Header" ContentSource="Header" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
     </Border>
     <ToggleButton x:Name="Expander" Width="20" Focusable="False" IsTabStop="False" ClickMode="Press" Foreground="{TemplateBinding Foreground}"
                   IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="{local:Translate TextC7F4E3E28851}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border Background="Transparent">
        <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8" Width="4" Height="8" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
       </Border>
       <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="ChildrenGuide" Grid.Row="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Ts.BorderStrong}" IsHitTestVisible="False"/>
     <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/><Setter TargetName="ChildrenGuide" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/><Setter TargetName="ChildrenGuide" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger SourceName="HeaderFrame" Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{DynamicResource Ts.Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{DynamicResource Ts.Text}"/><Setter Property="Foreground" Value="{DynamicResource Ts.Canvas}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderFrame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HeaderFrame" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AssetItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,12"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="frame" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Panel}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.Accent}"/><Setter TargetName="frame" Property="Background" Value="{DynamicResource Ts.Pressed}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.TextSecondary}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="browserGrid">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="navColumn" Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="detailColumn" Width="270"/></Grid.ColumnDefinitions>
  <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,1,0" Background="{DynamicResource Ts.Raised}">
   <DockPanel Margin="14,18">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="{local:Translate Text0D7F700390DB}" FontSize="10" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,0,0,12"/>
     <Button Content="{local:Translate TextFC14887CED6F}" Style="{StaticResource NavButton}" Click="AllClicked"/>
     <Button Content="{local:Translate Text7F8044F85387}" Style="{StaticResource NavButton}" Click="UnassignedClicked"/>
     <Button Content="{local:Translate TextF4EDEAE56B65}" Style="{StaticResource NavButton}" Click="RecentClicked"/>
     <DockPanel Margin="0,24,0,8"><Button Content="+" DockPanel.Dock="Right" Click="NewProjectClicked" ToolTip="{local:Translate Text49ED84AC6492}" AutomationProperties.Name="{local:Translate Text49ED84AC6492}"/><TextBlock Text="{local:Translate TextBB9EC32D295C}" VerticalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}" FontSize="11"/></DockPanel>
    </StackPanel>
    <TreeView x:Name="projectTree" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" SelectedItemChanged="TreeSelected" AllowDrop="True" Drop="TreeDrop" DragOver="TreeDragOver" PreviewMouseLeftButtonDown="TreeMouseDown" PreviewMouseMove="TreeMouseMove" AutomationProperties.Name="{local:Translate TextA71D10D12ADC}"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="20,18,8,8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel>
    <WrapPanel DockPanel.Dock="Right"><Button Content="{local:Translate Text753CB453EF62}" Click="ImportClicked"/><Button Content="{local:Translate Text5AE910EC31BB}" Click="CreateClicked" Margin="6,0,0,0"/></WrapPanel>
    <TextBlock x:Name="viewTitle" Text="{local:Translate TextFC14887CED6F}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <Grid Grid.Row="1" Margin="0,18,4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
    <Grid><TextBox x:Name="searchInput" TextChanged="FiltersChanged" ToolTip="{local:Translate Text776DC2577A66}" AutomationProperties.Name="{local:Translate TextD275FDA822F3}"/>
     <TextBlock Text="{local:Translate TextD6E65E98BB7A}" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=searchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <ComboBox x:Name="scopeInput" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="FiltersChanged" AutomationProperties.Name="{local:Translate Text87038A34D05B}"><ComboBoxItem Content="{local:Translate Text2948A31485B8}"/><ComboBoxItem Content="{local:Translate Text7D70BED45C3F}"/><ComboBoxItem Content="{local:Translate Text57597C1CB946}"/></ComboBox>
   </Grid>
   <WrapPanel Grid.Row="2" Margin="0,0,0,14">
    <ComboBox x:Name="kindInput" Width="154" SelectedIndex="0" SelectionChanged="FiltersChanged" AutomationProperties.Name="{local:Translate TextD60CFB118B9C}"><ComboBoxItem Content="{local:Translate Text19161353D3BF}"/><ComboBoxItem Content="{local:Translate Text0A6258A5F30F}"/><ComboBoxItem Content="{local:Translate TextDF37C74A068D}"/><ComboBoxItem Content="{local:Translate Text9143EB5DCC80}"/><ComboBoxItem Content="{local:Translate TextE7BD3412C5C6}"/></ComboBox>
    <TextBlock Text="{local:Translate TextD0F7B8094A0B}" Margin="8,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}"/><TextBox x:Name="filterWidth" Width="54" TextChanged="FiltersChanged" ToolTip="{local:Translate Text817E81333022}" AutomationProperties.Name="{local:Translate Text37D5FF67F65F}"/>
    <TextBlock Text="×" Margin="3,0" VerticalAlignment="Center"/><TextBox x:Name="filterHeight" Width="54" TextChanged="FiltersChanged" ToolTip="{local:Translate TextF02B06AD635E}" AutomationProperties.Name="{local:Translate Text20E3F28A9E09}"/>
    <ComboBox x:Name="alphaInput" Width="140" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="FiltersChanged" AutomationProperties.Name="{local:Translate Text04A35F4E4903}"><ComboBoxItem Content="{local:Translate Text1DA75E23160B}"/><ComboBoxItem Content="{local:Translate Text00BA8ACD5E78}"/><ComboBoxItem Content="{local:Translate Text2496129FC3DE}"/></ComboBox>
    <Button Content="{local:Translate Text407F871778D3}" Click="ResetFilters" Margin="6,0,0,0" Padding="6,4"/>
   </WrapPanel>
   <Grid Grid.Row="3">
    <ListBox x:Name="assetList" SelectionMode="Extended" SelectionChanged="AssetSelected" MouseDoubleClick="OpenDoubleClick" KeyDown="AssetKeyDown" PreviewMouseLeftButtonDown="AssetMouseDown" PreviewMouseMove="AssetMouseMove" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource AssetItem}" AutomationProperties.Name="{local:Translate Text36484D8C388F}">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><Grid Width="180" ToolTip="{Binding Name}">
      <Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource Ts.Thumbnail}"><Grid><TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource Ts.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Grid></Border>
      <StackPanel Grid.Row="1" Margin="10"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,5,0,0"/><TextBlock Text="{Binding TagLabel}" FontSize="11" Foreground="{DynamicResource Ts.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock Text="{Binding LocationLabel}" FontSize="10" Foreground="{DynamicResource Ts.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel x:Name="emptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" IsHitTestVisible="False"><TextBlock Text="{local:Translate TextB69BDD2BCE72}" FontSize="19" TextAlignment="Center"/><TextBlock Text="{local:Translate Text8E308FD21650}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,12,0,0"/></StackPanel>
   </Grid>
   <TextBlock x:Name="countLabel" Grid.Row="4" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,8" FontSize="11"/>
  </Grid>
  <Border x:Name="detailsBorder" Grid.Column="2" Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1,0,0,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18">
    <TextBlock Text="{local:Translate Text1A5F1627B232}" FontSize="10" Foreground="{DynamicResource Ts.TextMuted}"/>
    <Image x:Name="detailPreview" Height="130" Margin="0,16" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    <TextBlock x:Name="detailName" Text="{local:Translate Text85DE61BC1CCC}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="detailSummary" Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" Margin="0,7,0,14"/>
    <Button x:Name="openAssetButton" Content="{local:Translate Text7969171D49E8}" Click="OpenClicked" IsEnabled="False"/>
    <TextBlock Text="{local:Translate TextC8FA45FB52C9}" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,20,0,6"/>
    <TextBox x:Name="tagsInput" TextWrapping="Wrap" MinHeight="50" AutomationProperties.Name="{local:Translate Text598B799BA7A9}"/>
    <Button Content="{local:Translate Text443D403DF52E}" Click="TagsClicked" Margin="0,7,0,0"/>
    <TextBlock x:Name="usageLabel" Text="" TextWrapping="Wrap" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,20,0,12"/>
    <Button Content="{local:Translate Text0CC4E220DE75}" Click="AddToProjectClicked" Margin="0,3"/>
    <Button Content="{local:Translate Text1212BAEB7103}" Click="MoveClicked" Margin="0,3"/>
    <Button Content="{local:Translate TextBA5A59519E29}" Click="UnlinkClicked" Margin="0,3"/>
    <Button Content="{local:Translate Text70566E0E10B0}" Click="CopyClicked" Margin="0,3" ToolTip="{local:Translate Text8E5DAAB68277}"/>
    <Separator Margin="0,15"/>
    <Button Content="{local:Translate Text19DA9CC76C17}" Click="DeleteClicked" Margin="0,3"/>
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
</UserControl>
