<UserControl x:Class="DomainColorTest.IconWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DomainColorTest"
    Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
            <DrawingBrush x:Key="IconChecker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                <DrawingBrush.Drawing><DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource Ts.Thumbnail}" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="{DynamicResource Ts.Hover}" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                </DrawingGroup></DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,0,1" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="iconOpenButton" Content="{local:Translate Text0DF7E1837013}" Margin="0,0,7,0"/>
                    <Button x:Name="iconSaveButton" Content="{local:Translate Text5D6114287865}" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                </StackPanel>
                <Button x:Name="iconBackButton" Content="←" Width="34" Margin="0,0,10,0" DockPanel.Dock="Left" ToolTip="{local:Translate TextAD94907F6423}" AutomationProperties.Name="{local:Translate TextAD94907F6423}"/>
                <TextBlock Text="{local:Translate Text08836605DFFE}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
        <Grid x:Name="iconContent" Grid.Row="1">
            <Grid x:Name="iconSetupGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <Border x:Name="iconSettingsPanel" Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,1,0" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="iconControls">
                            <StackPanel x:Name="iconImagePanel">
                                <TextBlock Text="{local:Translate Text1EB3278B5211}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <Border Height="156" Background="{StaticResource IconChecker}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="iconSourceImage" Margin="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock x:Name="iconEmptyHint" Text="{local:Translate Text73C0387A0340}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="iconFileLabel" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,16" Foreground="{DynamicResource Ts.TextMuted}"/>
                            </StackPanel>
                            <local:EditorMaterialPicker x:Name="iconEditorChoices" Visibility="Collapsed" Margin="0,0,0,12"/>
                            <TextBlock Text="{local:Translate Text575D5055D734}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="iconSizes" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,16">
                                <CheckBox x:Name="iconCustomCheck" Content="{local:Translate TextB5311F8310FC}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <local:IntegerInput x:Name="iconCustomSize" Minimum="1" Maximum="256" Value="96" Width="78" IsEnabled="False" AutomationProperties.Name="{local:Translate TextB74101A9928D}"/>
                            </DockPanel>
                            <TextBlock Text="{local:Translate Text91377953A789}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="iconResizeMode" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="{local:Translate TextB2B2565DFCB8}"/><ComboBoxItem Content="{local:Translate TextCAA44972888C}"/>
                            </ComboBox>
                            <TextBlock Text="{local:Translate TextAA7F21A2DE79}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="iconFitMode" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="{local:Translate Text8196B8163A31}"/><ComboBoxItem Content="{local:Translate Text129593A4C4E0}"/><ComboBoxItem Content="{local:Translate Text647AA759250F}"/>
                            </ComboBox>
                            <CheckBox x:Name="iconRemoveBackground" Content="{local:Translate TextE0139DC77000}" ToolTip="{local:Translate TextED3C4D64FF9A}"/>
                            <WrapPanel x:Name="iconBackgroundSettings" Visibility="Collapsed" Margin="0,8,0,0">
                                <StackPanel Width="220">
                                    <TextBlock Text="{local:Translate TextC058D95FDDDA}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="iconBackgroundMode" SelectedIndex="0" Margin="0,0,0,12" AutomationProperties.Name="{local:Translate TextBE4B7CFCDA6F}">
                                        <ComboBoxItem Content="{local:Translate TextEED43C5404C3}"/><ComboBoxItem Content="{local:Translate TextE649FA322395}"/>
                                    </ComboBox>
                                    <TextBlock Text="{local:Translate Text03449D9A17C3}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="iconBackgroundColor" SelectedIndex="0" Margin="0,0,0,12">
                                        <ComboBoxItem Content="{local:Translate Text2BC89F591254}"/><ComboBoxItem Content="{local:Translate TextA024A93D4E0C}"/><ComboBoxItem Content="{local:Translate Text1CA9B6B05DFC}"/>
                                    </ComboBox>
                                    <DockPanel Margin="0,0,0,6"><TextBlock Text="{local:Translate TextC6F992FFD17B}"/><TextBlock Text="{Binding Value, ElementName=iconBackgroundTolerance, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                                    <Slider x:Name="iconBackgroundTolerance" Minimum="0" Maximum="100" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutomationProperties.Name="{local:Translate Text0C4B88F7B78A}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <ScrollViewer x:Name="iconScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="{local:Translate Text870884E44CE1}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="iconPreviewHint" Text="{local:Translate Text2C678E406BF6}" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="iconFrames">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Margin="0,0,24,24" VerticalAlignment="Bottom">
                                    <Grid Height="256" MinWidth="40">
                                        <Border Width="{Binding Size}" Height="{Binding Size}" VerticalAlignment="Bottom" Background="{StaticResource IconChecker}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1">
                                            <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,10,0,0" Style="{StaticResource TechnicalText}"/>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>