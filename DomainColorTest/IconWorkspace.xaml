<UserControl x:Class="DomainColorTest.IconWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DomainColorTest"
    Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
            <DrawingBrush x:Key="IconChecker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                <DrawingBrush.Drawing><DrawingGroup>
                    <GeometryDrawing Brush="#151515" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="#242424" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                </DrawingGroup></DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="iconOpenButton" Content="Открыть…" Margin="0,0,7,0"/>
                    <Button x:Name="iconSaveButton" Content="Сохранить ICO…" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                </StackPanel>
                <Button x:Name="iconBackButton" Content="←" Width="34" Margin="0,0,10,0" DockPanel.Dock="Left" ToolTip="На главную" AutomationProperties.Name="На главную"/>
                <TextBlock Text="Создание иконок" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
        <Grid x:Name="iconContent" Grid.Row="1">
            <Grid x:Name="iconSetupGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <Border x:Name="iconSettingsPanel" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="iconControls">
                            <StackPanel x:Name="iconImagePanel">
                                <TextBlock Text="ИСТОЧНИК" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <Border Height="156" Background="{StaticResource IconChecker}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="iconSourceImage" Margin="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock x:Name="iconEmptyHint" Text="Перетащите изображение" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="iconFileLabel" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,16" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <local:EditorMaterialPicker x:Name="iconEditorChoices" Visibility="Collapsed" Margin="0,0,0,12"/>
                            <TextBlock Text="Размеры ICO" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="iconSizes" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,16">
                                <CheckBox x:Name="iconCustomCheck" Content="Свой размер" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <local:IntegerInput x:Name="iconCustomSize" Minimum="1" Maximum="256" Value="96" Width="78" IsEnabled="False" AutomationProperties.Name="Сторона иконки в пикселях"/>
                            </DockPanel>
                            <TextBlock Text="Масштабирование" Margin="0,0,0,6"/>
                            <ComboBox x:Name="iconResizeMode" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="Пиксельное"/><ComboBoxItem Content="Плавное"/>
                            </ComboBox>
                            <TextBlock Text="Пропорции" Margin="0,0,0,6"/>
                            <ComboBox x:Name="iconFitMode" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="Вписать в квадрат"/><ComboBoxItem Content="Обрезать по центру"/><ComboBoxItem Content="Растянуть"/>
                            </ComboBox>
                            <CheckBox x:Name="iconRemoveBackground" Content="Удалить фон" ToolTip="Исходник не изменяется."/>
                            <WrapPanel x:Name="iconBackgroundSettings" Visibility="Collapsed" Margin="0,8,0,0">
                                <StackPanel Width="220">
                                    <TextBlock Text="Способ удаления" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="iconBackgroundMode" SelectedIndex="0" Margin="0,0,0,12" AutomationProperties.Name="Способ удаления фона">
                                        <ComboBoxItem Content="По цвету везде"/><ComboBoxItem Content="От краёв"/>
                                    </ComboBox>
                                    <TextBlock Text="Цвет фона" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="iconBackgroundColor" SelectedIndex="0" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Авто по краям"/><ComboBoxItem Content="Белый"/><ComboBoxItem Content="Чёрный"/>
                                    </ComboBox>
                                    <DockPanel Margin="0,0,0,6"><TextBlock Text="Допуск"/><TextBlock Text="{Binding Value, ElementName=iconBackgroundTolerance, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                                    <Slider x:Name="iconBackgroundTolerance" Minimum="0" Maximum="100" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutomationProperties.Name="Допуск удаления фона"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <ScrollViewer x:Name="iconScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="РЕЗУЛЬТАТЫ" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="iconPreviewHint" Text="Выберите размеры — они будут сохранены в одном ICO." Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="iconFrames">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Margin="0,0,24,24" VerticalAlignment="Bottom">
                                    <Grid Height="256" MinWidth="40">
                                        <Border Width="{Binding Size}" Height="{Binding Size}" VerticalAlignment="Bottom" Background="{StaticResource IconChecker}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" Style="{StaticResource TechnicalText}"/>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>