<Window x:Class="DomainColorTest.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DomainColorTest"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Внешний вид · TESSERA" Icon="Assets/app.ico"
        Width="440" MinWidth="380" SizeToContent="Height" MaxHeight="650"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}"
        FontFamily="{DynamicResource Ts.UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="AppearanceKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="ThemeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ts.Text}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Frame" Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}"
                        BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Ellipse Stroke="{DynamicResource Ts.BorderStrong}" StrokeThickness="1"/>
                            <Ellipse x:Name="Selection" Width="8" Height="8" Fill="{DynamicResource Ts.Accent}" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Ts.Hover}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ts.Accent}"/><Setter TargetName="Selection" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></Window.Resources>
    <Border BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Background="{DynamicResource Ts.Raised}">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource CloseCaptionButton}" Click="CloseAppearance"
                        ToolTip="Закрыть" AutomationProperties.Name="Закрыть настройки внешнего вида"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <TextBlock Text="Внешний вид" FontFamily="{DynamicResource Ts.DisplayFont}" FontWeight="SemiBold"
                           Margin="16,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="20,20,20,12">
                <TextBlock Text="Тема приложения" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <RadioButton x:Name="lightTheme" Tag="Light" GroupName="AppearanceTheme" Style="{StaticResource ThemeChoice}"
                             Checked="ThemeSelected" AutomationProperties.Name="Светлая тема">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="48" Height="44" Background="#E5E2D5" BorderBrush="#AAA99B" BorderThickness="1" HorizontalAlignment="Left">
                            <StackPanel Margin="6"><Border Height="6" Background="#383B35" Margin="0,0,0,5"/><Border Height="18" Background="#D8D5C8" BorderBrush="#AAA99B" BorderThickness="1"/></StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Светлая" FontWeight="SemiBold"/>
                            <TextBlock Text="Мягкие светлые поверхности" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="darkTheme" Tag="Dark" GroupName="AppearanceTheme" Style="{StaticResource ThemeChoice}"
                             Checked="ThemeSelected" AutomationProperties.Name="Тёмная тема">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="48" Height="44" Background="#101010" BorderBrush="#686868" BorderThickness="1" HorizontalAlignment="Left">
                            <StackPanel Margin="6"><Border Height="6" Background="#EEEEEE" Margin="0,0,0,5"/><Border Height="18" Background="#191919" BorderBrush="#3A3A3A" BorderThickness="1"/></StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Тёмная" FontWeight="SemiBold"/>
                            <TextBlock Text="Спокойный монохром" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="contrastTheme" Tag="Contrast" GroupName="AppearanceTheme" Style="{StaticResource ThemeChoice}"
                             Checked="ThemeSelected" AutomationProperties.Name="Контрастная тема">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="48" Height="44" Background="#0C0C0C" BorderBrush="#808080" BorderThickness="1" HorizontalAlignment="Left">
                            <StackPanel Margin="6"><Border Height="6" Background="#FF7424" Margin="0,0,0,5"/><Border Height="18" Background="#202020" BorderBrush="#4B4B4B" BorderThickness="1"/></StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Контрастная" FontWeight="SemiBold"/>
                            <TextBlock Text="Тёмная с оранжевым акцентом" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <TextBlock Text="Тема применяется сразу и сохраняется автоматически." Foreground="{DynamicResource Ts.TextMuted}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,6"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
