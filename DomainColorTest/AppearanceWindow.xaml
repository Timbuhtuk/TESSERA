<Window x:Class="DomainColorTest.AppearanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DomainColorTest" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="{local:Translate TextA0D69D0757FD}" Icon="Assets/app.ico" Width="440" MinWidth="380" SizeToContent="Height" MaxHeight="650" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}" FontFamily="{DynamicResource Ts.UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="AppearanceKeyDown">
