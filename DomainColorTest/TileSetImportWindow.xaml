<Window x:Class="DomainColorTest.TileSetImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DomainColorTest"
        Title="{local:Translate Text6C30CDC6C442}" Icon="Assets/app.ico" Width="920" Height="740" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}"
        FontFamily="{DynamicResource Ts.UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" PreviewDragOver="AtlasDragOver" Drop="AtlasDropped">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><local:TileInspectorResources/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button x:Name="openAtlasButton" DockPanel.Dock="Right" Content="{local:Translate Text8FA9FE6D3CAF}" Click="OpenAtlasClicked" Margin="12,0,0,0"/>
            <StackPanel>
                <TextBlock Text="{local:Translate Text7F765A904858}" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="sourceLabel" Text="{local:Translate TextE566619CB2A2}" Foreground="{DynamicResource Ts.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                    <StackPanel x:Name="settingsPanel">
                        <TextBlock Text="{local:Translate TextFC981D9C92DB}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="modeInput" SelectedIndex="0" SelectionChanged="ModeChanged" AutomationProperties.Name="{local:Translate TextA68843BC5300}">
                            <ComboBoxItem Content="{local:Translate TextDDEEAE8ACBFE}"/><ComboBoxItem Content="{local:Translate Text8279CE213962}"/>
                        </ComboBox>
                        <TextBlock x:Name="firstLabel" Text="{local:Translate Text49A9AE45BE6B}" Margin="0,12,0,4"/>
                        <TextBox x:Name="firstInput" Text="32" Padding="7,5" TextChanged="GridTextChanged" AutomationProperties.Name="{local:Translate TextF690A9A0BC4F}"/>
                        <TextBlock x:Name="secondLabel" Text="{local:Translate Text813182F283C2}" Margin="0,10,0,4"/>
                        <TextBox x:Name="secondInput" Text="32" Padding="7,5" TextChanged="GridTextChanged" AutomationProperties.Name="{local:Translate Text7010B92FFE0A}"/>
                        <Button Content="{local:Translate Text4E405FB87F2E}" Click="UseThreeBySix" Margin="0,12,0,0" ToolTip="{local:Translate TextED00489712B5}"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                        <Button x:Name="detectButton" Content="{local:Translate Text02F3DD41EEC8}" Click="DetectClicked" IsEnabled="False"/>
                        <ComboBox x:Name="suggestionsInput" SelectionChanged="SuggestionChanged" Margin="0,8,0,0" AutomationProperties.Name="{local:Translate Text421127F945F9}"/>
                        <TextBlock x:Name="suggestionHint" Text="{local:Translate Text5AA8159AA219}" Style="{StaticResource Hint}"/>
                        <Expander Header="{local:Translate Text219F0CCE48BB}" Margin="0,12,0,0">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{local:Translate Text71C635E8F1D5}" TextWrapping="Wrap"/><TextBox x:Name="marginXInput" Text="0" TextChanged="GridTextChanged" Padding="7,5" AutomationProperties.Name="{local:Translate Text60EFC2474A4C}"/>
                                <TextBlock Text="{local:Translate TextAC31FB317202}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBox x:Name="marginYInput" Text="0" TextChanged="GridTextChanged" Padding="7,5" AutomationProperties.Name="{local:Translate TextD514EBE417BD}"/>
                                <TextBlock Text="{local:Translate Text0BF67C5BEA32}" Margin="0,8,0,0"/><TextBox x:Name="spacingXInput" Text="0" TextChanged="GridTextChanged" Padding="7,5" AutomationProperties.Name="{local:Translate Text870E6E1E945E}"/>
                                <TextBlock Text="{local:Translate TextC01BFAA0AB93}" Margin="0,8,0,0"/><TextBox x:Name="spacingYInput" Text="0" TextChanged="GridTextChanged" Padding="7,5" AutomationProperties.Name="{local:Translate TextCCCFFC7C6281}"/>
                            </StackPanel>
                        </Expander>
                        <CheckBox Style="{StaticResource Ts.SwitchBox}" ToolTipService.ShowOnDisabled="True" x:Name="skipEmptyInput" Margin="0,14,0,0" ToolTip="{local:Translate TextE8610A242F26}"><TextBlock Text="{local:Translate TextBBA9027BE377}" TextWrapping="Wrap"/></CheckBox>
                        <TextBlock Text="{local:Translate TextBF438935BEF2}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True">
                <local:TileSetPreview x:Name="atlasPreview"/>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="layoutSummary" Text="{local:Translate Text5CDCCD071BC2}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="statusLabel" Text="{local:Translate Text30A91C1844DB}" TextWrapping="Wrap" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="importButton" Content="{local:Translate TextBE17A327E3E7}" Click="ImportClicked" IsEnabled="False" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
