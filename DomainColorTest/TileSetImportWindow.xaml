<Window x:Class="DomainColorTest.TileSetImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DomainColorTest"
        Title="Импорт тайлсета · TESSERA" Icon="Assets/app.ico" Width="920" Height="740" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}"
        FontFamily="{DynamicResource Ts.UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" PreviewDragOver="AtlasDragOver" Drop="AtlasDropped">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><local:TileInspectorResources/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button x:Name="openAtlasButton" DockPanel.Dock="Right" Content="Открыть тайлсет…" Click="OpenAtlasClicked" Margin="12,0,0,0"/>
            <StackPanel>
                <TextBlock Text="Разрезать тайлсет" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="sourceLabel" Text="Откройте атлас или перетащите его в окно" Foreground="{DynamicResource Ts.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                    <StackPanel x:Name="settingsPanel">
                        <TextBlock Text="Разбиение" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="modeInput" SelectedIndex="0" SelectionChanged="ModeChanged" AutomationProperties.Name="Режим разбиения">
                            <ComboBoxItem Content="Размер тайла, px"/><ComboBoxItem Content="Столбцы и строки"/>
                        </ComboBox>
                        <TextBlock x:Name="firstLabel" Text="Ширина тайла, px" Margin="0,12,0,4"/>
                        <TextBox x:Name="firstInput" Text="32" Padding="7,5" TextChanged="GridTextChanged" AutomationProperties.Name="Ширина тайла или число столбцов"/>
                        <TextBlock x:Name="secondLabel" Text="Высота тайла, px" Margin="0,10,0,4"/>
                        <TextBox x:Name="secondInput" Text="32" Padding="7,5" TextChanged="GridTextChanged" AutomationProperties.Name="Высота тайла или число строк"/>
                        <Button Content="Сетка 3 × 6" Click="UseThreeBySix" Margin="0,12,0,0" ToolTip="Например, 96×192 → тайлы 32×32"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                        <Button x:Name="detectButton" Content="Автоподбор сетки" Click="DetectClicked" IsEnabled="False"/>
                        <ComboBox x:Name="suggestionsInput" SelectionChanged="SuggestionChanged" Margin="0,8,0,0" AutomationProperties.Name="Варианты сетки тайлсета"/>
                        <TextBlock x:Name="suggestionHint" Text="Автоподбор предлагает сетку. Проверьте её на предпросмотре перед импортом." Style="{StaticResource Hint}"/>
                        <Expander Header="Отступы и промежутки" Margin="0,12,0,0">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Отступ слева и справа, px" TextWrapping="Wrap"/><TextBox x:Name="marginXInput" Text="0" TextChanged="GridTextChanged" Padding="7,5" AutomationProperties.Name="Горизонтальные отступы атласа"/>
                                <TextBlock Text="Отступ сверху и снизу, px" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBox x:Name="marginYInput" Text="0" TextChanged="GridTextChanged" Padding="7,5" AutomationProperties.Name="Вертикальные отступы атласа"/>
                                <TextBlock Text="Промежуток по X, px" Margin="0,8,0,0"/><TextBox x:Name="spacingXInput" Text="0" TextChanged="GridTextChanged" Padding="7,5" AutomationProperties.Name="Промежуток между столбцами"/>
                                <TextBlock Text="Промежуток по Y, px" Margin="0,8,0,0"/><TextBox x:Name="spacingYInput" Text="0" TextChanged="GridTextChanged" Padding="7,5" AutomationProperties.Name="Промежуток между строками"/>
                            </StackPanel>
                        </Expander>
                        <CheckBox x:Name="skipEmptyInput" Margin="0,14,0,0"><TextBlock Text="Пропускать пустые тайлы" TextWrapping="Wrap"/></CheckBox>
                        <TextBlock Text="По умолчанию сохраняются все ячейки, включая прозрачные. Порядок — слева направо, сверху вниз." Style="{StaticResource Hint}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True">
                <local:TileSetPreview x:Name="atlasPreview"/>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="layoutSummary" Text="Выберите изображение тайлсета" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="statusLabel" Text="Исходное изображение сохраняется без изменений" TextWrapping="Wrap" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="importButton" Content="Добавить тайлы в коллекцию" Click="ImportClicked" IsEnabled="False" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
