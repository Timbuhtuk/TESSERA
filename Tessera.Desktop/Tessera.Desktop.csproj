<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Tessera</Product>
    <AssemblyTitle>Tessera</AssemblyTitle>
    <Description>Tessera — 2D graphics workspace</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <ReleaseNotesFile Condition="'$(ReleaseNotesFile)' == ''">$(MSBuildProjectDirectory)\..\release-notes\catalog.json</ReleaseNotesFile>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Tessera.WpfStyles" Version="0.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tessera.Models\Tessera.Models.csproj" />
    <ProjectReference Include="..\Tessera.Core\Tessera.Core.csproj" />
    <ProjectReference Include="..\Tessera.Aseprite\Tessera.Aseprite.csproj" />
    <ProjectReference Include="..\Tessera.Rendering\Tessera.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\settings.svg" />
    <Resource Include="Assets\unreal-mark.svg" />
    <Resource Include="Assets\ResultIcons\*.svg" />
    <EmbeddedResource Include="Localization\en.json" LogicalName="Tessera.Localization.en.json" />
    <EmbeddedResource Include="$(ReleaseNotesFile)" LogicalName="Tessera.ReleaseNotes.json" />
    <EmbeddedResource Include="..\Unreal\TesseraSync\TesseraSync.uplugin" LogicalName="Tessera.Unreal.TesseraSync.uplugin" />
    <EmbeddedResource Include="..\Unreal\TesseraSync\Content\Python\init_unreal.py" LogicalName="Tessera.Unreal.Content/Python/init_unreal.py" />
    <EmbeddedResource Include="..\Unreal\TesseraSync\Content\Python\tessera_sync.py" LogicalName="Tessera.Unreal.Content/Python/tessera_sync.py" />
    <EmbeddedResource Include="..\Unreal\TesseraSync\Content\Python\tessera_project.py" LogicalName="Tessera.Unreal.Content/Python/tessera_project.py" />
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\landscape.png" />
    <Resource Include="Assets\palette-preview-photo.png" />
    <Resource Include="Assets\animation-banner.png" />
    <Resource Include="Assets\Fonts\Cascadia-Code-OFL.txt" />
    <Resource Include="Assets\Fonts\Science-Gothic-OFL.txt" />
    <None Include="Assets\Fonts\Cascadia-Code-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\Science-Gothic-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
