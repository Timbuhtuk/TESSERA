<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\app.ico</ApplicationIcon>
    <Product>Tessera</Product>
    <AssemblyTitle>Tessera</AssemblyTitle>
    <Description>Tessera — 2D graphics workspace</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <ReleaseNotesFile Condition="'$(ReleaseNotesFile)' == ''">$(MSBuildProjectDirectory)\..\release-notes\catalog.json</ReleaseNotesFile>
  </PropertyGroup>


  <ItemGroup>
    <Using Include="Tessera.Models" />
    <Using Include="Tessera.WpfStyles.Controls.IntegerInput" Alias="IntegerInput" />
    <Using Include="Tessera.WpfStyles.Controls.NotificationKind" Alias="NotificationKind" />
    <Using Include="Tessera.WpfStyles.Controls.NotificationPlacement" Alias="NotificationPlacement" />
    <Using Include="Tessera.WpfStyles.Controls.ColorArea" Alias="ColorArea" />
    <Using Include="Tessera.Core.Workflows" />
    <InternalsVisibleTo Include="Tessera.RegressionTests" />
    <PackageReference Include="Tessera.WpfStyles" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tessera.Models\Tessera.Models.csproj" />
    <ProjectReference Include="..\Tessera.Core\Tessera.Core.csproj" />
    <ProjectReference Include="..\Tessera.Aseprite\Tessera.Aseprite.csproj" />
    <ProjectReference Include="..\Tessera.Rendering\Tessera.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Brand\app.ico" />
    <Resource Include="Assets\Icons\settings.svg" />
    <Resource Include="Assets\Icons\unreal-mark.svg" />
    <Resource Include="Assets\Icons\Results\*.svg" />
    <Resource Include="Assets\Icons\Workspace\*.svg" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="Tessera.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Maintenance\Uninstall.ps1" LogicalName="Tessera.Uninstall.ps1" />
    <EmbeddedResource Include="$(ReleaseNotesFile)" LogicalName="Tessera.ReleaseNotes.json" />
    <Resource Include="Assets\Brand\app-icon.png" />
    <EmbeddedResource Include="..\Unreal\TesseraSync\TesseraSync.uplugin" LogicalName="Tessera.Unreal.TesseraSync.uplugin" />
    <EmbeddedResource Include="..\Unreal\TesseraSync\Content\Python\*.py" LogicalName="Tessera.Unreal.%(Filename)%(Extension)" />
    <Resource Include="Assets\Previews\palette-preview-photo.png" />
    <Resource Include="Assets\Fonts\Cascadia-Code-OFL.txt" />
    <Resource Include="Assets\Fonts\Science-Gothic-OFL.txt" />
    <None Include="Assets\Fonts\Cascadia-Code-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\Science-Gothic-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
