<UserControl x:Class="Tessera.Desktop.NotificationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="410" Visibility="Collapsed" Focusable="False"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             AutomationProperties.LiveSetting="Polite">
    <UserControl.Resources>
        <SolidColorBrush x:Key="NotificationSuccess" Color="#299758" />
        <SolidColorBrush x:Key="NotificationAttention" Color="#D84D49" />
        <SolidColorBrush x:Key="NotificationInformation" Color="#C46F1C" />
    </UserControl.Resources>
    <Grid SizeChanged="CardSurfaceSizeChanged">
        <Grid.Clip>
            <RectangleGeometry x:Name="cardOutline" RadiusX="8" RadiusY="8" />
        </Grid.Clip>
        <Border Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.BorderStrong}"
                BorderThickness="1" CornerRadius="8" Padding="7,5,7,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path x:Name="kindIcon" Width="22" Height="22" Stretch="Uniform"
                      VerticalAlignment="Center" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <StackPanel Grid.Column="1" Margin="7,0,4,0" VerticalAlignment="Center">
                    <TextBlock x:Name="heading" FontFamily="{DynamicResource Ts.UiFont}" Foreground="{DynamicResource Ts.Text}"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="statusLabel" FontFamily="{DynamicResource Ts.UiFont}" FontSize="12"
                               Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="85" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <Button x:Name="dismiss" Grid.Column="2" Width="24" Height="24" MinWidth="24" MinHeight="24"
                        Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Background="Transparent" BorderBrush="Transparent">
                    <Path Width="10" Height="10" Stretch="Uniform" Data="M 1,1 L 9,9 M 9,1 L 1,9"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{DynamicResource Ts.TextSecondary}" />
                </Button>
            </Grid>
        </Border>
        <Border x:Name="countdownTrack" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Ts.BorderStrong}">
            <Border Background="{Binding Stroke, ElementName=kindIcon}">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="countdownScale" />
                </Border.RenderTransform>
            </Border>
        </Border>
    </Grid>
</UserControl>
