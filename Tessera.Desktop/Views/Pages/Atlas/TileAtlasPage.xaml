<Page x:Class="Tessera.Desktop.TileAtlasPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Tessera.Desktop" Focusable="False">
    <Page.Resources><local:AppearanceResources /></Page.Resources>
    <Grid x:Name="atlasPreviewHost" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="6" /><RowDefinition /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="0" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
        <local:PixelPreview x:Name="atlasImagePreview" Cursor="Cross" />
        <DockPanel x:Name="atlasRepeatPane" Grid.Row="2">
            <StackPanel x:Name="atlasPaintRail" DockPanel.Dock="Top" Orientation="Horizontal">
                <ListBox x:Name="atlasPaintTool" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Tag="{Binding Orientation, ElementName=atlasPaintRail}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="35" />
                            <Setter Property="Height" Value="35" />
                            <Setter Property="Margin" Value="0,0,3,3" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="frame" BorderThickness="1" BorderBrush="{DynamicResource Ts.Border}" Background="{DynamicResource Ts.Panel}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Ts.Hover}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="frame" Property="Background" Value="{DynamicResource Ts.Pressed}" />
                                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.Text}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Opacity" Value="0.45" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Button x:Name="atlasColorButton" Width="35" Height="35" Padding="4" Margin="0,0,3,3">
                    <Border x:Name="atlasColorChecker" Width="22" Height="22" BorderThickness="1" BorderBrush="{DynamicResource Ts.BorderStrong}">
                        <Border x:Name="atlasColorSwatch" />
                    </Border>
                </Button>
                <Button x:Name="atlasRepeatResetButton" Width="35" Height="35" Padding="4" Margin="0,0,3,3"
                        IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="ResetAtlasRepeat">
                    <Path Data="M3,12 A9,9 0 1 1 12,21 A9,9 0 0 1 5.6,18.4 M3,5 V12 H10" Width="18" Height="18"
                          Stretch="Uniform" Stroke="{DynamicResource Ts.Text}" StrokeThickness="1.65" StrokeLineJoin="Round" />
                </Button>
            </StackPanel>
            <ScrollViewer x:Name="atlasRepeatScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource Ts.Raised}">
                <local:TilePreview x:Name="atlasRepeatPreview" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Page>
