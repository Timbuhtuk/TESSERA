<Page x:Class="Tessera.Desktop.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Tessera.Desktop" Focusable="False">
    <Page.Resources><local:AppearanceResources /></Page.Resources>
    <Grid>
        <ScrollViewer x:Name="homeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="homeContent" Margin="32,8,32,24">
                <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True">
                    <Grid MinHeight="250" Background="{DynamicResource Ts.Canvas}">
                        <StackPanel x:Name="heroCopy" Margin="32,28" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="520">
                            <TextBlock x:Name="heroTitle" Text="{local:Translate PixelProcessing}" Style="{StaticResource DisplayTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate ImageDownscalingAndGridAlignment}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" LineHeight="23" />
                            <Button x:Name="homeOpenButton" Content="{local:Translate OpenImageAction}" Style="{StaticResource PrimaryButton}" Click="HomeOpenImage" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" ToolTip="{local:Translate OpenImagesCtrlO}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="asepriteBanner" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True" Margin="0,16,0,0" Background="{DynamicResource Ts.Raised}">
                    <Grid MinHeight="220">
                        <StackPanel x:Name="asepriteBannerCopy" Margin="32,28" MaxWidth="500" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock x:Name="asepriteBannerTitle" Text="{local:Translate AnimationExport}" Style="{StaticResource DisplayTitle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate AsepritePNGJSON}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" TextWrapping="Wrap" />
                            <Button x:Name="homeAsepriteButton" Content="{local:Translate OpenConverterAction}" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="backgroundBanner" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True" Margin="0,16,0,0" Background="{DynamicResource Ts.Raised}">
                    <Grid Height="220">
                        <StackPanel x:Name="backgroundBannerArt" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,46,0" IsHitTestVisible="False">
                            <Border Width="126" Height="126" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Background="{DynamicResource Ts.TextSecondary}">
                                <TextBlock Text="T" FontFamily="{StaticResource UiFont}" FontWeight="Black" FontSize="100" Foreground="{DynamicResource Ts.Raised}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="→" FontSize="34" Foreground="{DynamicResource Ts.TextMuted}" VerticalAlignment="Center" Margin="22,0" />
                            <Border Width="126" Height="126" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1">
                                <Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing><DrawingGroup>
                                        <GeometryDrawing Brush="{DynamicResource Ts.Panel}" Geometry="M0,0 H20 V20 H0 Z" />
                                        <GeometryDrawing Brush="{DynamicResource Ts.Hover}" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z" />
                                    </DrawingGroup></DrawingBrush.Drawing>
                                </DrawingBrush></Border.Background>
                                <TextBlock Text="T" FontFamily="{StaticResource UiFont}" FontWeight="Black" FontSize="100" Foreground="{DynamicResource Ts.Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="backgroundBannerCopy" Margin="32,28" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="500">
                            <TextBlock x:Name="backgroundBannerTitle" Text="{local:Translate BackgroundRemoval}" Style="{StaticResource DisplayTitle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate TransparentPNGImageSolidBackground}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" TextWrapping="Wrap" />
                            <Button x:Name="homeBackgroundButton" Content="{local:Translate RemoveBackgroundAction}" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="iconBanner" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True" Margin="0,16,0,0" Background="{DynamicResource Ts.Raised}">
                    <Grid Height="220">
                        <StackPanel x:Name="iconBannerArt" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,46,0" IsHitTestVisible="False" Opacity="0.7">
                            <Image Source="pack://application:,,,/Tessera.Desktop;component/Assets/Brand/app-icon.png" Width="32" Height="32" Margin="0,70,22,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Image Source="pack://application:,,,/Tessera.Desktop;component/Assets/Brand/app-icon.png" Width="64" Height="64" Margin="0,38,22,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Border BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Padding="10"><Image Source="pack://application:,,,/Tessera.Desktop;component/Assets/Brand/app-icon.png" Width="128" Height="128" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Border>
                        </StackPanel>
                        <StackPanel x:Name="iconBannerCopy" Margin="32,28" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock x:Name="iconBannerTitle" Text="{local:Translate IconCreation}" Style="{StaticResource DisplayTitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate CreateICOSourceOrSavedResult}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" TextWrapping="Wrap" />
                            <Button x:Name="homeIconButton" Content="{local:Translate CreateIconAction}" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="moodboardBanner" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" ClipToBounds="True" Margin="0,16,0,0" Background="{DynamicResource Ts.Raised}">
                    <Grid Height="220">
                        <Canvas x:Name="moodboardBannerArt" Width="340" Height="170" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,55,0" IsHitTestVisible="False">
                            <Border Canvas.Left="20" Canvas.Top="18" Width="176" Height="130" Background="#242424" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" />
                            <Border Canvas.Left="42" Canvas.Top="33" Width="116" Height="84" Background="#8D8D8D" BorderBrush="#E6E6E6" BorderThickness="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-9" /></Border.RenderTransform>
                                <TextBlock Text="T" FontFamily="{StaticResource UiFont}" FontWeight="Black" FontSize="63" Foreground="#202020" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Canvas.Left="166" Canvas.Top="53" Width="127" Height="89" Background="#4B4B4B" BorderBrush="{DynamicResource Ts.TextSecondary}" BorderThickness="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="12" /></Border.RenderTransform>
                                <TextBlock Text="▧" FontSize="65" Foreground="#D0D0D0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Canvas.Left="270" Canvas.Top="27" Width="11" Height="11" Fill="{DynamicResource Ts.Text}" />
                        </Canvas>
                        <StackPanel x:Name="moodboardBannerCopy" Margin="32,28" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="500">
                            <TextBlock x:Name="moodboardBannerTitle" Text="{local:Translate ImageBoard}" Style="{StaticResource DisplayTitle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock Text="{local:Translate CollectReferencesCanvasOneLayerPer}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="15" TextWrapping="Wrap" />
                            <Button x:Name="homeMoodboardButton" Content="{local:Translate CreateBoardAction}" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="17,12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="libraryHeading" Margin="0,26,0,18">
                    <TextBlock Text="{local:Translate ImageLibrary}" Style="{StaticResource SectionTitle}" />
                </Grid>
                <Border x:Name="emptyLibrary" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Padding="28" Background="{DynamicResource Ts.Raised}">
                    <StackPanel>
                        <TextBlock Text="{local:Translate NoImages}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{local:Translate DropFilesIntoWindowOrOpen}" Foreground="{DynamicResource Ts.TextMuted}" FontSize="14" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="libraryCards">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:LibraryPage}}}" Margin="0,0,12,14" Padding="0" Tag="{Binding}" Click="OpenLibraryCard" HorizontalContentAlignment="Stretch" ToolTip="{local:Translate ContinueEditingImage}" AutomationProperties.Name="{Binding Label}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="156" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Background="{DynamicResource Ts.Thumbnail}" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="12" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Border>
                                <StackPanel Grid.Row="1" Margin="17">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource Ts.TextMuted}" FontSize="13" Margin="0,9,0,0"><Run Text="{Binding Width, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Height, Mode=OneWay}" /><Run Text="{local:Translate PxResultsPrefix}" /><Run Text="{Binding Generations.Count, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <local:WorkspaceBrowser x:Name="browser" Visibility="Collapsed" />
    </Grid>
</Page>
