<UserControl x:Class="Tessera.Desktop.BackgroundWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Tessera.Desktop"
    Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="backgroundControls">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,0,1" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel x:Name="backgroundHeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="backgroundOpenButton" Content="{local:Translate OpenAction}" Margin="0,0,7,0"/>
                    <Button x:Name="backgroundSaveButton" Content="{local:Translate SavePNGAction}" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                </StackPanel>
                <Button x:Name="backgroundBackButton" Content="←" Width="34" Margin="0,0,10,0" DockPanel.Dock="Left" ToolTip="{local:Translate Home}" AutomationProperties.Name="{local:Translate Home}"/>
                <TextBlock Text="{local:Translate BackgroundRemoval}" ToolTip="{local:Translate BackgroundRemoval}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
        <Grid x:Name="backgroundContent" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
            <Border x:Name="backgroundSettingsPanel" Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,1,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{local:Translate Settings}" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                        <local:EditorMaterialPicker x:Name="backgroundEditorChoices" Visibility="Collapsed" Margin="0,0,0,12"/>
                        <TextBlock Text="{local:Translate RemovalMethod}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="backgroundModeInput" SelectedIndex="0" AutomationProperties.Name="{local:Translate BackgroundRemovalMethod}" Margin="0,0,0,16">
                            <ComboBoxItem Content="{local:Translate MatchingColorAnywhere}"/><ComboBoxItem Content="{local:Translate FromEdges}"/>
                        </ComboBox>
                        <TextBlock Text="{local:Translate BackgroundColor}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="backgroundColorInput" SelectedIndex="0" Margin="0,0,0,8">
                            <ComboBoxItem Content="{local:Translate AutoFromEdges}"/><ComboBoxItem Content="{local:Translate White}"/><ComboBoxItem Content="{local:Translate Black}"/>
                            <ComboBoxItem x:Name="backgroundCustomColorOption"/>
                        </ComboBox>
                        <Button x:Name="backgroundChooseColorButton" HorizontalContentAlignment="Stretch" Margin="0,0,0,6">
                            <DockPanel>
                                <Border x:Name="backgroundSelectedSwatch" Width="22" Height="18" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Margin="0,0,8,0"/>
                                <TextBlock x:Name="backgroundSelectedColorText" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>
                        <CheckBox Style="{StaticResource Ts.CompactSwitchBox}" x:Name="backgroundPickColorToggle" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{local:Translate Tolerance}"/>
                            <TextBlock Text="{Binding Value, ElementName=backgroundToleranceInput, StringFormat={}{0}%}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="backgroundToleranceInput" Minimum="0" Maximum="100" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutomationProperties.Name="{local:Translate BackgroundRemovalTolerance}"/>
                        <TextBlock Text="{local:Translate At0MeansAnExactMatch}" Style="{StaticResource Ts.Hint}"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,12"/>
                        <TextBlock x:Name="backgroundManualTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource Ts.CompactSwitchBox}" x:Name="backgroundEraserToggle" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,10"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="backgroundBrushSizeTitle"/>
                            <TextBlock Text="{Binding Value, ElementName=backgroundBrushSizeInput, StringFormat={}{0} px}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="backgroundBrushSizeInput" Minimum="1" Maximum="127" Value="9" TickFrequency="2" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
                        <WrapPanel Margin="0,8,0,10">
                            <Button x:Name="backgroundUndoEraseButton" Margin="0,0,6,6"/>
                            <Button x:Name="backgroundResetEraseButton" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock x:Name="backgroundManualHint" Style="{StaticResource Ts.Hint}"/>
                        <TextBlock x:Name="backgroundZoomTitle" Margin="0,14,0,6"/>
                        <ComboBox x:Name="backgroundZoomInput" SelectedIndex="0" Margin="0,0,0,8">
                            <ComboBoxItem x:Name="backgroundFitZoomOption"/>
                            <ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/>
                            <ComboBoxItem Content="800%"/><ComboBoxItem Content="1600%"/>
                        </ComboBox>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,12"/>
                        <TextBlock x:Name="backgroundFileLabel" Foreground="{DynamicResource Ts.TextMuted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="backgroundPreviewScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="backgroundPreviewGrid" Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="backgroundSourcePanel">
                        <TextBlock Text="{local:Translate Input}" Style="{StaticResource Ts.Caption}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Thumbnail}" Height="355">
                            <local:PixelPreview x:Name="backgroundSourcePreview" EmptyText="{local:Translate DropAnImage}" PreviewBackground="0"/>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="backgroundResultPanel" Grid.Column="2">
                        <TextBlock Text="{local:Translate Result}" Style="{StaticResource Ts.Caption}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Thumbnail}" Height="355">
                            <local:PixelPreview x:Name="backgroundResultPreview" EmptyText="{local:Translate TheResultWillAppearHereLabel}" PreviewBackground="0"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
