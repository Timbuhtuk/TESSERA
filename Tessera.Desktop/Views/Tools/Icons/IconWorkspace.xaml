<UserControl x:Class="Tessera.Desktop.IconWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Tessera.Desktop"
    Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
            <DrawingBrush x:Key="IconChecker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                <DrawingBrush.Drawing><DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource Ts.Thumbnail}" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="{DynamicResource Ts.Hover}" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                </DrawingGroup></DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,0,1" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="iconOpenButton" Content="{local:Translate OpenAction}" Margin="0,0,7,0"/>
                    <Button x:Name="iconSaveButton" Content="{local:Translate SaveICOAction}" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                </StackPanel>
                <Button x:Name="iconBackButton" Content="←" Width="34" Margin="0,0,10,0" DockPanel.Dock="Left" ToolTip="{local:Translate Home}" AutomationProperties.Name="{local:Translate Home}"/>
                <TextBlock Text="{local:Translate IconCreation}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
        <Grid x:Name="iconContent" Grid.Row="1">
            <Grid x:Name="iconSetupGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <Border x:Name="iconSettingsPanel" Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,1,0" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="iconControls">
                            <StackPanel x:Name="iconImagePanel">
                                <TextBlock Text="{local:Translate Input}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <Border Height="156" Background="{StaticResource IconChecker}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1">
                                    <Grid>
                                        <ScrollViewer x:Name="iconSourceScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                                      Background="Transparent" CanContentScroll="False">
                                            <Image x:Name="iconSourceImage" Margin="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </ScrollViewer>
                                        <TextBlock x:Name="iconEmptyHint" Text="{local:Translate DropAnImage}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="iconFileLabel" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,16" Foreground="{DynamicResource Ts.TextMuted}"/>
                            </StackPanel>
                            <local:EditorMaterialPicker x:Name="iconEditorChoices" Visibility="Collapsed" Margin="0,0,0,12"/>
                            <TextBlock Text="{local:Translate ICOSizes}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="iconSizes" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,16">
                                <CheckBox Style="{StaticResource Ts.SwitchBox}" ToolTipService.ShowOnDisabled="True" x:Name="iconCustomCheck" Content="{local:Translate CustomSize}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{local:Translate AddICOFrameManuallySpecifiedSize}" />
                                <local:IntegerInput x:Name="iconCustomSize" Minimum="1" Maximum="256" Value="96" Width="78" IsEnabled="False" AutomationProperties.Name="{local:Translate IconSideLengthInPixels}"/>
                            </DockPanel>
                            <TextBlock Text="{local:Translate Scaling}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="iconResizeMode" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="{local:Translate NearestNeighbor}"/><ComboBoxItem Content="{local:Translate Smooth}"/>
                            </ComboBox>
                            <TextBlock Text="{local:Translate AspectRatio}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="iconFitMode" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="{local:Translate FitIntoSquare}"/><ComboBoxItem Content="{local:Translate CenterCrop}"/><ComboBoxItem Content="{local:Translate Stretch}"/>
                            </ComboBox>
                            <CheckBox Style="{StaticResource Ts.SwitchBox}" ToolTipService.ShowOnDisabled="True" x:Name="iconRemoveBackground" Content="{local:Translate RemoveBackground}" ToolTip="{local:Translate MakesSelectedSolidBackgroundTransparentWhen}"/>
                            <WrapPanel x:Name="iconBackgroundSettings" Visibility="Collapsed" Margin="0,8,0,0">
                                <StackPanel Width="220">
                                    <TextBlock Text="{local:Translate RemovalMethod}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="iconBackgroundMode" SelectedIndex="0" Margin="0,0,0,12" AutomationProperties.Name="{local:Translate BackgroundRemovalMethod}">
                                        <ComboBoxItem Content="{local:Translate MatchingColorAnywhere}"/><ComboBoxItem Content="{local:Translate FromEdges}"/>
                                    </ComboBox>
                                    <TextBlock Text="{local:Translate BackgroundColor}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="iconBackgroundColor" SelectedIndex="0" Margin="0,0,0,12">
                                        <ComboBoxItem Content="{local:Translate AutoFromEdges}"/><ComboBoxItem Content="{local:Translate White}"/><ComboBoxItem Content="{local:Translate Black}"/>
                                    </ComboBox>
                                    <DockPanel Margin="0,0,0,6"><TextBlock Text="{local:Translate Tolerance}"/><TextBlock Text="{Binding Value, ElementName=iconBackgroundTolerance, StringFormat={}{0}%}" HorizontalAlignment="Right"/></DockPanel>
                                    <Slider x:Name="iconBackgroundTolerance" Minimum="0" Maximum="100" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutomationProperties.Name="{local:Translate BackgroundRemovalTolerance}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <ScrollViewer x:Name="iconScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
                    <Border Width="{Binding ViewportWidth, ElementName=iconScroll}" MinWidth="312" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{local:Translate Results}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="iconPreviewHint" Text="{local:Translate SelectSizesIncludeSingleICOFile}" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="iconFrames">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Margin="0,0,24,24" VerticalAlignment="Bottom">
                                    <Grid Height="256" MinWidth="40">
                                        <Border Width="{Binding Size}" Height="{Binding Size}" VerticalAlignment="Bottom" Background="{StaticResource IconChecker}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1">
                                            <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,10,0,0" Style="{StaticResource TechnicalText}"/>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
