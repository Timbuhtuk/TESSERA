<UserControl x:Class="Tessera.Desktop.MoodboardWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Tessera.Desktop"
    Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="startPanel">
            <Border Width="520" MaxWidth="520" Padding="32" Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{local:Translate NEWBoardHeading}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{local:Translate ArrangeImagesOnASingleCanvas}" Style="{StaticResource DisplayTitle}" FontSize="29" TextWrapping="Wrap" Margin="0,10,0,12"/>
                    <TextBlock Text="{local:Translate EachImageBecomesASeparateLayer}" Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,23"/>
                    <TextBlock Text="{local:Translate WidthPx}" Margin="0,0,0,6"/>
                    <local:IntegerInput x:Name="widthInput" Minimum="128" Maximum="16384" Value="1200" AutomationProperties.Name="{local:Translate BoardWidth}" Margin="0,0,0,15"/>
                    <TextBlock Text="{local:Translate HeightPx}" Margin="0,0,0,6"/>
                    <local:IntegerInput x:Name="heightInput" Minimum="128" Maximum="16384" Value="800" AutomationProperties.Name="{local:Translate BoardHeight}" Margin="0,0,0,23"/>
                    <Button x:Name="createButton" Content="{local:Translate CreateCanvas}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="18,11"/>
                    <Button x:Name="openStartButton" Content="{local:Translate OpenSavedBoardAction}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="editorPanel" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,0,1" Padding="10,8">
                <WrapPanel>
                    <Button x:Name="newButton" Content="{local:Translate NewBoardAction}" Margin="0,0,7,5"/>
                    <Button x:Name="addButton" Content="{local:Translate AddImagesAction}" Margin="0,0,7,5"/>
                    <Button x:Name="saveProjectButton" Content="{local:Translate SaveBoardAction}" Margin="0,0,7,5"/>
                    <Button x:Name="openProjectButton" Content="{local:Translate OpenBoardAction}" Margin="0,0,7,5"/>
                    <Button x:Name="exportButton" Content="{local:Translate ExportPNGAction}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,5"/>
                    <ComboBox x:Name="boardZoomInput" SelectedIndex="0" Width="100" Margin="7,0,0,5" ToolTip="{local:Translate MouseWheelOverTheCanvas}" AutomationProperties.Name="{local:Translate BoardZoom}"><ComboBoxItem Content="{local:Translate Fit}"/><ComboBoxItem Content="6,25%"/><ComboBoxItem Content="12,5%"/><ComboBoxItem Content="25%"/><ComboBoxItem Content="50%"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/><ComboBoxItem Content="800%"/><ComboBoxItem Content="1600%"/><ComboBoxItem Content="3200%"/><ComboBoxItem Content="6400%"/></ComboBox>
                </WrapPanel>
            </Border>
            <Grid x:Name="editorContent" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <Border x:Name="layersPanel" Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,1,0" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock x:Name="boardSizeLabel" Style="{StaticResource Hint}"/>
                            <TextBlock Text="{local:Translate CtrlOrShiftClickSelectMultiple}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                            <TextBlock Text="{local:Translate ImageViewportGestures}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{local:Translate Layers}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{local:Translate BackgroundColor}" Margin="0,12,0,6"/>
                            <Button x:Name="backgroundColorButton" AutomationProperties.Name="{local:Translate ChooseBoardBackgroundColor}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="backgroundSwatch" Width="22" Height="22" Background="White" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="backgroundHex" Text="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <ListBox x:Name="layerList" Height="240" SelectionMode="Extended" AutomationProperties.Name="{local:Translate BoardLayers}" DisplayMemberPath="Name"/>
                            <WrapPanel Margin="0,9,0,14">
                                <Button x:Name="upButton" Content="{local:Translate MoveUp}" Margin="0,0,5,5" ToolTip="{local:Translate RaiseLayer}"/>
                                <Button x:Name="downButton" Content="{local:Translate MoveDown}" Margin="0,0,5,5" ToolTip="{local:Translate LowerLayer}"/>
                                <Button x:Name="toFrontButton" Content="{local:Translate BringToFront}" Margin="0,0,5,5" ToolTip="{local:Translate BringSelectedLayersToFront}"/>
                                <Button x:Name="toBackButton" Content="{local:Translate SendToBack}" Margin="0,0,5,5" ToolTip="{local:Translate SendSelectedLayersToBack}"/>
                                <Button x:Name="deleteButton" Content="{local:Translate Delete}" Margin="0,0,5,5" ToolTip="{local:Translate DeleteSelectedLayers}"/>
                            </WrapPanel>
                            <TextBlock Text="{local:Translate Rotation}" Margin="0,0,0,5"/>
                            <Slider x:Name="rotationSlider" Minimum="-180" Maximum="180" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{local:Translate RotateSelectedLayers}"/>
                            <TextBlock x:Name="rotationLabel" Text="0°" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,0,0,10"/>
                            <TextBlock Text="{local:Translate Size}" Margin="0,0,0,5"/>
                            <Slider x:Name="scaleSlider" Minimum="10" Maximum="300" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{local:Translate ResizeSelectedLayers}"/>
                            <TextBlock x:Name="scaleLabel" Text="100%" Foreground="{DynamicResource Ts.TextSecondary}"/>
                        </StackPanel>
                    </DockPanel>
                    </ScrollViewer>
                </Border>
                <Grid x:Name="boardArea" Grid.Column="1" Background="{DynamicResource Ts.Canvas}" AllowDrop="True">
                    <ScrollViewer x:Name="boardScroll" Background="{DynamicResource Ts.Canvas}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="Both">
                        <Grid x:Name="boardZoomHost" Background="{DynamicResource Ts.Canvas}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Viewbox x:Name="boardViewbox" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="boardFrame" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Background="White">
                                    <Canvas x:Name="boardSurface" Background="White" ClipToBounds="True" Width="1200" Height="800"/>
                                </Border>
                            </Viewbox>
                        </Grid>
                    </ScrollViewer>
                    <TextBlock x:Name="emptyHint" Text="{local:Translate AddImagesOrDropThemHere}" FontSize="16" Foreground="{DynamicResource Ts.BorderStrong}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
