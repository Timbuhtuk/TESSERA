<UserControl x:Class="Tessera.Desktop.WorkspaceBrowser"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Tessera.Desktop" Foreground="{DynamicResource Ts.Text}" AllowDrop="True">
 <UserControl.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries>
  <ContextMenu x:Key="WorkspaceAssetContextMenu"/>
  <ItemsPanelTemplate x:Key="TileItemsPanel"><local:WorkspaceAssetPanel CellWidth="192" CellHeight="196"/></ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="SmallTileItemsPanel"><local:WorkspaceAssetPanel CellWidth="140" CellHeight="158"/></ItemsPanelTemplate>
  <ItemsPanelTemplate x:Key="ListItemsPanel"><local:WorkspaceAssetPanel CellHeight="66"/></ItemsPanelTemplate>
  <Style x:Key="AssetKindGlyph" TargetType="local:WorkspaceAssetIcon">
   <Setter Property="Kind" Value="{Binding Kind}"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding KindLabel}"/>
   <Setter Property="Foreground" Value="{DynamicResource Ts.TextSecondary}"/>
  </Style>
  <Style x:Key="AssetRowGlyph" TargetType="local:WorkspaceAssetIcon" BasedOn="{StaticResource AssetKindGlyph}">
   <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"/>
   <Setter Property="Margin" Value="4,0,0,0"/>
  </Style>
  <Style x:Key="AssetMetadata" TargetType="TextBlock">
   <Setter Property="Text" Value="{Binding MetadataLabel}"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="TextWrapping" Value="NoWrap"/>
   <Setter Property="Foreground" Value="{DynamicResource Ts.TextSecondary}"/>
  </Style>
  <Style x:Key="AssetPreviewGlyph" TargetType="local:WorkspaceAssetIcon" BasedOn="{StaticResource AssetKindGlyph}">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="AssetPreviewTemplate">
   <Border Background="{DynamicResource Ts.Thumbnail}"><Grid>
    <local:WorkspaceAssetIcon Style="{StaticResource AssetPreviewGlyph}" Width="28" Height="28"/>
    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
   </Grid></Border>
  </DataTemplate>
  <DataTemplate x:Key="AssetListPreviewTemplate">
   <Border Background="{DynamicResource Ts.Thumbnail}"><Grid>
    <local:WorkspaceAssetIcon Style="{StaticResource AssetPreviewGlyph}" Width="22" Height="22"/>
    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
   </Grid></Border>
  </DataTemplate>
  <DataTemplate x:Key="AssetTileTemplate"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AssetPreviewTemplate}"/>
   <Grid Grid.Row="1" Margin="8,4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <local:WorkspaceAssetName Text="{Binding DisplayName}"/>
     <TextBlock Style="{StaticResource AssetMetadata}" Margin="0,2,0,0" LineStackingStrategy="BlockLineHeight" LineHeight="14"/>
    </StackPanel>
    <local:WorkspaceAssetIcon Grid.Column="1" Style="{StaticResource AssetRowGlyph}"/>
   </Grid>
  </Grid></DataTemplate>
  <DataTemplate x:Key="AssetSmallTileTemplate"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AssetPreviewTemplate}"/>
   <Grid Grid.Row="1" Margin="6,4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="14"/></Grid.RowDefinitions>
    <local:WorkspaceAssetName Text="{Binding DisplayName}" AllowSecondLine="True"/>
    <TextBlock Grid.Row="1" Style="{StaticResource AssetMetadata}" Margin="0,2,0,0" TextWrapping="Wrap"
               LineStackingStrategy="BlockLineHeight" LineHeight="12" MaxHeight="24" VerticalAlignment="Top" FontSize="10"/>
    <local:WorkspaceAssetIcon Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource AssetRowGlyph}"/>
   </Grid>
  </Grid></DataTemplate>
  <DataTemplate x:Key="AssetListTemplate"><Grid Margin="7">
   <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AssetListPreviewTemplate}"/>
   <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
    <local:WorkspaceAssetName Text="{Binding DisplayName}"/>
    <TextBlock Style="{StaticResource AssetMetadata}"/>
   </StackPanel>
   <local:WorkspaceAssetIcon Grid.Column="2" Style="{StaticResource AssetRowGlyph}"/>
  </Grid></DataTemplate>
  <DataTemplate x:Key="AssetToolTipTemplate">
   <StackPanel MinWidth="180" MaxWidth="340">
    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding ToolTipFields}" ItemTemplate="{StaticResource Ts.ToolTipFieldTemplate}"
                  Grid.IsSharedSizeScope="True" HorizontalContentAlignment="Stretch" Margin="0,4,0,0"/>
   </StackPanel>
  </DataTemplate>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource Ts.CompactButton}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,2"/>
  </Style>
  <Style TargetType="TreeViewItem">
   <Setter Property="Foreground" Value="{DynamicResource Ts.Text}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
     <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="HeaderFrame" Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" MinHeight="20">
      <ContentPresenter x:Name="PART_Header" ContentSource="Header" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
     </Border>
     <ToggleButton x:Name="Expander" Width="20" Height="20" MinHeight="0" Padding="0" Focusable="False" IsTabStop="False" ClickMode="Press" Foreground="{TemplateBinding Foreground}"
                   IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="{local:Translate ExpandOrCollapse}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border Background="Transparent">
        <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8" Width="4" Height="8" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
       </Border>
       <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="ChildrenGuide" Grid.Row="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Ts.BorderStrong}" IsHitTestVisible="False"/>
     <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/><Setter TargetName="ChildrenGuide" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/><Setter TargetName="ChildrenGuide" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger SourceName="HeaderFrame" Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{DynamicResource Ts.Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{DynamicResource Ts.Text}"/><Setter Property="Foreground" Value="{DynamicResource Ts.Canvas}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderFrame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HeaderFrame" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AssetItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="ContextMenu" Value="{StaticResource WorkspaceAssetContextMenu}"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="frame" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Background="{DynamicResource Ts.Panel}" ToolTipService.ShowDuration="15000">
     <Border.ToolTip>
      <ToolTip Content="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource AssetToolTipTemplate}"/>
     </Border.ToolTip>
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.Accent}"/><Setter TargetName="frame" Property="Background" Value="{DynamicResource Ts.Pressed}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.TextSecondary}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TileAssetItem" TargetType="ListBoxItem" BasedOn="{StaticResource AssetItem}"><Setter Property="Width" Value="180"/><Setter Property="Height" Value="184"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
  <Style x:Key="SmallTileAssetItem" TargetType="ListBoxItem" BasedOn="{StaticResource AssetItem}"><Setter Property="Width" Value="130"/><Setter Property="Height" Value="148"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
  <Style x:Key="ListAssetItem" TargetType="ListBoxItem" BasedOn="{StaticResource AssetItem}"><Setter Property="Height" Value="62"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style x:Key="AssetViewModeButton" TargetType="RadioButton">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,3,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Frame" Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Padding="5">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ts.TextSecondary}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Ts.Pressed}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ts.Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="browserGrid">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="navColumn" Width="210" MinWidth="200" MaxWidth="420"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
  <Border BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,1,0" Background="{DynamicResource Ts.Raised}">
   <DockPanel Margin="14,18,0,0">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,14,0">
     <TextBlock Text="{local:Translate Workspace}" FontSize="10" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,0,0,12"/>
     <Button Content="{local:Translate AllAssets}" Style="{StaticResource NavButton}" Click="AllClicked"/>
     <Button Content="{local:Translate Unassigned}" Style="{StaticResource NavButton}" Click="UnassignedClicked"/>
     <Button Content="{local:Translate Recent}" Style="{StaticResource NavButton}" Click="RecentClicked"/>
     <DockPanel x:Name="projectHeader" Margin="0,24,0,8">
      <Button x:Name="addProjectButton" Content="+" DockPanel.Dock="Right" Click="OpenProjectMenuClicked" ToolTip="{local:Translate CreateProject}" AutomationProperties.Name="{local:Translate CreateProject}">
       <Button.ContextMenu><ContextMenu MinWidth="180"><MenuItem x:Name="localProjectMenuItem" Click="NewProjectClicked"/><MenuItem x:Name="unrealProjectMenuItem" Click="ConnectUnrealClicked"/></ContextMenu></Button.ContextMenu>
      </Button>
      <TextBlock Text="{local:Translate Projects}" VerticalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}" FontSize="11"/>
     </DockPanel>
     <Grid x:Name="unrealStatusPanel" Margin="0,5,0,0" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Ellipse x:Name="unrealStatusDot" Width="9" Height="9" StrokeThickness="1.5" Margin="0,1,7,0" VerticalAlignment="Top"/>
      <TextBlock x:Name="unrealStatus" Grid.Column="1" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Ts.TextSecondary}"/>
     </Grid>
    </StackPanel>
    <TreeView x:Name="projectTree" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItemChanged="TreeSelected" AllowDrop="True" Drop="TreeDrop" DragOver="TreeDragOver" PreviewMouseLeftButtonDown="TreeMouseDown" PreviewMouseMove="TreeMouseMove" AutomationProperties.Name="{local:Translate ProjectsAndFolders}">
     <TreeView.Resources>
      <Style TargetType="{x:Type ScrollBar}">
       <Setter Property="Background" Value="{DynamicResource Ts.Raised}"/>
       <Setter Property="Width" Value="8"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ScrollBar}">
        <Grid x:Name="Rail" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}">
         <Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value}">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Style="{StaticResource Ts.ScrollPageButton}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource Ts.ScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Style="{StaticResource Ts.ScrollPageButton}"/></Track.IncreaseRepeatButton>
         </Track>
        </Grid>
        <ControlTemplate.Triggers>
         <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/>
          <Setter TargetName="Rail" Property="Width" Value="Auto"/><Setter TargetName="Rail" Property="Height" Value="8"/>
          <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
          <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
          <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
         </Trigger>
         <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Rail" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style>
     </TreeView.Resources>
    </TreeView>
   </DockPanel>
  </Border>
  <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Ts.Hover}" Cursor="SizeWE" AutomationProperties.Name="{local:Translate LibraryPaneWidth}" />
  <Grid Grid.Column="2" Margin="20,18,8,8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="viewTitle" Text="{local:Translate AllAssets}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <ToggleButton x:Name="filtersToggle" Grid.Column="1" Content="{local:Translate Filters}" Click="FiltersToggled"
                  VerticalAlignment="Top" MinHeight="34" Padding="12,4" Margin="12,0,0,0"/>
   </Grid>
   <Grid Grid.Row="1" Margin="0,12,0,0" SizeChanged="GallerySizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
    <ListBox x:Name="assetList" SelectionMode="Extended" SelectionChanged="AssetSelected" MouseDoubleClick="OpenDoubleClick" KeyDown="AssetKeyDown" PreviewMouseLeftButtonDown="AssetMouseDown" PreviewMouseMove="AssetMouseMove" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemContainerStyle="{StaticResource TileAssetItem}" ItemTemplate="{StaticResource AssetTileTemplate}" AutomationProperties.Name="{local:Translate LibraryAssets}"/>
    <StackPanel x:Name="emptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" IsHitTestVisible="False"><TextBlock Text="{local:Translate APlaceForYourMaterials}" FontSize="19" TextAlignment="Center"/><TextBlock Text="{local:Translate OpenOrDropFiles}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,12,0,0"/></StackPanel>
     </Grid>
     <Grid Grid.Row="1" Margin="0,8,4,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="countLabel" Foreground="{DynamicResource Ts.TextMuted}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="11" Margin="0,0,10,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="assetViewLabel" VerticalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}" Margin="0,0,7,0"/>
     <RadioButton x:Name="assetViewTiles" GroupName="AssetViewMode" Style="{StaticResource AssetViewModeButton}" Checked="AssetViewChanged">
      <UniformGrid Rows="2" Columns="2" Width="20" Height="20"><Rectangle Fill="{DynamicResource Ts.Text}" Margin="1"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="1"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="1"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="1"/></UniformGrid>
     </RadioButton>
     <RadioButton x:Name="assetViewSmallTiles" GroupName="AssetViewMode" Style="{StaticResource AssetViewModeButton}" Checked="AssetViewChanged">
      <UniformGrid Rows="3" Columns="3" Width="20" Height="20"><Rectangle Fill="{DynamicResource Ts.Text}" Margin="0.7"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="0.7"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="0.7"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="0.7"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="0.7"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="0.7"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="0.7"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="0.7"/><Rectangle Fill="{DynamicResource Ts.Text}" Margin="0.7"/></UniformGrid>
     </RadioButton>
     <RadioButton x:Name="assetViewList" GroupName="AssetViewMode" Style="{StaticResource AssetViewModeButton}" Margin="0" Checked="AssetViewChanged">
      <StackPanel Width="20"><Rectangle Height="4" Fill="{DynamicResource Ts.Text}" Margin="0,0,0,3"/><Rectangle Height="4" Fill="{DynamicResource Ts.Text}" Margin="0,0,0,3"/><Rectangle Height="4" Fill="{DynamicResource Ts.Text}"/></StackPanel>
     </RadioButton>
    </StackPanel>
     </Grid>
    </Grid>
    <Border x:Name="filtersPane" Grid.Column="1" Panel.ZIndex="1" Width="228" HorizontalAlignment="Right" Margin="12,0,0,0" Padding="12"
            Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1">
     <Border.Style><Style TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=filtersToggle}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
     </Style></Border.Style>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <Grid>
        <TextBox x:Name="searchInput" TextChanged="FiltersChanged" ToolTip="{local:Translate SearchByNameLabel}" AutomationProperties.Name="{local:Translate SearchByName}"/>
        <TextBlock Text="{local:Translate NameAction}" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Ts.TextMuted}" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=searchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
       <TextBlock Text="{local:Translate Type}" Margin="0,14,0,4" Foreground="{DynamicResource Ts.TextSecondary}"/>
       <ComboBox x:Name="kindInput" SelectedIndex="0" SelectionChanged="FiltersChanged" AutomationProperties.Name="{local:Translate MaterialType}">
        <ComboBoxItem Content="{local:Translate AllTypes}"/><ComboBoxItem Content="{local:Translate Images}"/><ComboBoxItem Content="{local:Translate Animations}"/><ComboBoxItem Content="{local:Translate Boards}"/>
       </ComboBox>
       <TextBlock Text="{local:Translate Size}" Margin="0,14,0,4" Foreground="{DynamicResource Ts.TextSecondary}"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBox x:Name="filterWidth" TextChanged="FiltersChanged" ToolTip="{local:Translate WidthInPixels}" AutomationProperties.Name="{local:Translate WidthFilter}"/>
        <TextBlock Grid.Column="1" Text="×" Margin="8,0" VerticalAlignment="Center"/>
        <TextBox x:Name="filterHeight" Grid.Column="2" TextChanged="FiltersChanged" ToolTip="{local:Translate HeightInPixels}" AutomationProperties.Name="{local:Translate HeightFilter}"/>
       </Grid>
       <TextBlock Text="{local:Translate Background}" Margin="0,14,0,4" Foreground="{DynamicResource Ts.TextSecondary}"/>
       <ComboBox x:Name="alphaInput" SelectedIndex="0" SelectionChanged="FiltersChanged" AutomationProperties.Name="{local:Translate TransparencyFilter}">
        <ComboBoxItem Content="{local:Translate AnyOpacity}"/><ComboBoxItem Content="{local:Translate Transparent}"/><ComboBoxItem Content="{local:Translate Opaque}"/>
       </ComboBox>
       <Button x:Name="resetFiltersButton" Content="{local:Translate Reset}" Click="ResetFilters" Margin="0,16,0,0" Padding="6,4"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
