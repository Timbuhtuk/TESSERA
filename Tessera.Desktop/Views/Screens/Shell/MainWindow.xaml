<Window x:Class="Tessera.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Tessera.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="TESSERA" Icon="pack://application:,,,/Tessera.Desktop;component/Assets/Brand/app.ico" Width="1220" Height="880" MinWidth="560" MinHeight="700" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}" FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="45" ResizeBorderThickness="6,3,6,6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><local:AppearanceResources /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary></Window.Resources>
    <Grid x:Name="rootLayout" Background="{DynamicResource Ts.Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="titleBar" Height="48" Padding="0,8,0,0" Background="{DynamicResource Ts.Raised}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="libraryButton" Style="{StaticResource BrandButton}" Click="GoToLibrary" ToolTip="{local:Translate BackToLibrary}" AutomationProperties.Name="{local:Translate BackToLibrary}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <Image Source="pack://application:,,,/Tessera.Desktop;component/Assets/Brand/app-icon.png" Width="18" Height="18" Margin="0,0,9,0"/>
                        <TextBlock Text="TESSERA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Menu x:Name="mainMenu" Grid.Column="1" IsMainMenu="True" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Menu x:Name="libraryMenu" Grid.Column="1" IsMainMenu="True" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <TextBlock x:Name="fileLabel" Grid.Column="2" HorizontalAlignment="Left" MaxWidth="220" Margin="8,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Ts.TextMuted}" VerticalAlignment="Center"/>
                    <StackPanel x:Name="captionButtons" Grid.Column="3" Orientation="Horizontal">
                        <StackPanel x:Name="operationProgressPanel" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <ProgressBar x:Name="busyIndicator" Width="240" Height="14" Minimum="0" Maximum="100" Value="0"
                                         Style="{StaticResource Ts.ProgressCells}" IsIndeterminate="False" Visibility="Collapsed"
                                         AutomationProperties.Name="{local:Translate ProgressLabel}"/>
                        </StackPanel>
                        <Button x:Name="appearanceButton" Style="{StaticResource CaptionButton}" Click="OpenAppearance" ToolTip="{local:Translate Settings}" AutomationProperties.Name="{local:Translate Settings}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <local:SettingsIcon Width="18" Height="18" IsHitTestVisible="False" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="minimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="{local:Translate Minimize}" AutomationProperties.Name="{local:Translate Minimize}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M 0,5 L 10,5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                        </Button>
                        <Button x:Name="maximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="ToggleMaximizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1">
                                <Path.Style><Style TargetType="Path">
                                    <Setter Property="Data" Value="M 0,0 L 10,0 L 10,10 L 0,10 Z" />
                                    <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M 2,0 L 10,0 L 10,8 M 0,2 L 8,2 L 8,10 L 0,10 Z" /></DataTrigger></Style.Triggers>
                                </Style></Path.Style>
                            </Path>
                        </Button>
                        <Button x:Name="closeButton" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow" ToolTip="{local:Translate Close}" AutomationProperties.Name="{local:Translate Close}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                        </Button>
                    </StackPanel>
            </Grid>
        </Border>
        <Frame x:Name="editorFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Focusable="False" />
        <Frame x:Name="libraryFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Focusable="False" />
        <local:AsepriteWorkspace x:Name="asepriteWorkspace" Grid.Row="1" Visibility="Collapsed" />
        <local:IconWorkspace x:Name="iconWorkspace" Grid.Row="1" Visibility="Collapsed" />
        <local:BackgroundWorkspace x:Name="backgroundWorkspace" Grid.Row="1" Visibility="Collapsed" />
        <local:MoodboardWorkspace x:Name="moodboardWorkspace" Grid.Row="1" Visibility="Collapsed" />
        <local:NotificationDisplay x:Name="notificationDisplay" Grid.Row="1" Panel.ZIndex="10" />
    </Grid>
</Window>
