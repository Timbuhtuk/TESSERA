<Window x:Class="Tessera.Desktop.ColorReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tessera.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{local:Translate Text60AAB69B2C54}" Icon="pack://application:,,,/Tessera.Desktop;component/Assets/app.ico"
        Width="580" Height="535" MinWidth="420" MinHeight="450"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource Ts.Canvas}" Foreground="{DynamicResource Ts.Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><local:AppearanceResources/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Background="{DynamicResource Ts.Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Background="{DynamicResource Ts.Raised}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="dialogTitle" Text="{local:Translate TextFF8DA5F2551E}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock x:Name="basisBadge" Grid.Column="1" Foreground="{DynamicResource Ts.TextSecondary}" VerticalAlignment="Center" Margin="8,0"/>
            <Button Grid.Column="2" Content="×" Width="42" Height="38" FontSize="19" Style="{StaticResource CloseCaptionButton}" ToolTip="{local:Translate TextA7A4033657E8}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="dialogFrame" Style="{StaticResource Ts.DialogBorder}" Width="Auto" MinWidth="0" MaxWidth="Infinity" Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" Margin="16" VerticalAlignment="Top">
                <StackPanel>
                    <Border x:Name="oldColorSection" Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="oldColorLabel" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DockPanel x:Name="oldColorPanel">
                                <Button x:Name="oldSwatchButton" Width="38" Height="38" Padding="2" Margin="0,0,8,0" Click="OpenOldPalette">
                                    <Border x:Name="oldPreview" Width="28" Height="28" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1"/>
                                </Button>
                                <Button x:Name="sourcePickerButton" DockPanel.Dock="Right" Width="110" MinHeight="38" Height="38" Padding="8,4" FontSize="12" Margin="8,0,0,0" Click="PickSourceColor"/>
                                <TextBox x:Name="oldHexInput" Padding="10,4" MinHeight="38" Height="38" MaxLength="7" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Translate TextF2B1EEC11E15}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="newColorLabel" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button x:Name="newSwatchButton" Width="38" Height="38" Padding="2" Margin="0,0,8,0" Click="OpenNewPalette">
                                    <Border x:Name="newPreview" Width="28" Height="28" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1"/>
                                </Button>
                                <Button x:Name="targetPickerButton" DockPanel.Dock="Right" Width="110" MinHeight="38" Height="38" Padding="8,4" FontSize="12" Margin="8,0,0,0" Click="PickTargetColor"/>
                                <TextBox x:Name="newHexInput" Padding="10,4" MinHeight="38" Height="38" MaxLength="7" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Translate Text65EA219C02F5}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="singleColorPicker" Visibility="Collapsed" Margin="0,14,0,0">
                        <Grid x:Name="colorField" Width="320" Height="290" HorizontalAlignment="Center"
                              ClipToBounds="True" Cursor="Cross"
                              MouseLeftButtonDown="ColorFieldMouseDown" MouseMove="ColorFieldMouseMove"
                              MouseLeftButtonUp="ColorFieldMouseUp" LostMouseCapture="PickerLostCapture"
                              AutomationProperties.Name="{local:Translate Text6F4778880073}">
                            <Border x:Name="hueSurface"/>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="Black" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="fieldMarker" Width="18" Height="18" Stroke="White"
                                         StrokeThickness="2" Fill="Transparent">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="1"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                        <Grid x:Name="hueStrip" Width="320" Height="18" Margin="0,14,0,0" HorizontalAlignment="Center"
                              ClipToBounds="False" Cursor="Hand"
                              MouseLeftButtonDown="HueStripMouseDown" MouseMove="HueStripMouseMove"
                              MouseLeftButtonUp="HueStripMouseUp" LostMouseCapture="PickerLostCapture"
                              AutomationProperties.Name="{local:Translate Text477CA1567B76}">
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="Red" Offset="0"/>
                                        <GradientStop Color="Yellow" Offset="0.166667"/>
                                        <GradientStop Color="Lime" Offset="0.333333"/>
                                        <GradientStop Color="Cyan" Offset="0.5"/>
                                        <GradientStop Color="Blue" Offset="0.666667"/>
                                        <GradientStop Color="Magenta" Offset="0.833333"/>
                                        <GradientStop Color="Red" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="hueMarker" Width="10" Height="24" BorderBrush="White"
                                        BorderThickness="2" CornerRadius="5" Background="Transparent">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="1"/>
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>
                    </StackPanel>
                    <Border x:Name="paletteSection" Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1" Padding="10" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <Button x:Name="expandPaletteButton" DockPanel.Dock="Right" Content="↗" Width="32" Height="26" Padding="0" Click="ExpandPalette"/>
                                <TextBlock x:Name="paletteTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <local:ColorTreemap x:Name="replacementPalette" Height="128"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="validationText" Foreground="{DynamicResource Ts.TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="{local:Translate Text8FBE9B75CBDF}" Width="95" Margin="0,0,8,0" IsCancel="True" Click="CloseWindow"/>
                        <Button Grid.Column="2" x:Name="replaceButton" Width="150" Content="{local:Translate Text91282980BE62}" IsEnabled="False" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="ApplyColor"/>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
