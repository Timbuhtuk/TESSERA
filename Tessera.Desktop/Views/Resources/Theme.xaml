<ResourceDictionary xmlns:local="clr-namespace:Tessera.Desktop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Tessera.WpfStyles;component/Themes/TesseraTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource Ts.WrappedToolTip}" />
    <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource Ts.GutterScrollViewer}" />

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="Background" Value="{DynamicResource Ts.Canvas}" />
        <Setter Property="Foreground" Value="{DynamicResource Ts.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ts.UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="DisplayTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.HeroText}" />
    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.SectionText}" />
    <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.CardTitleText}" />
    <Style x:Key="TechnicalText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Ts.MutedText}" />
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Ts.HeroButton}" />

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource Ts.MenuItem}" />
    <Style TargetType="{x:Type Menu}" BasedOn="{StaticResource Ts.Menu}" />
    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource Ts.ContextMenu}" />
    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource Ts.PercentageSlider}" />

    <Style x:Key="ToolExpander" TargetType="{x:Type Expander}" BasedOn="{StaticResource {x:Type Expander}}" />

    <Style x:Key="BrandButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Ts.CaptionButton}">
        <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="39"/>
    </Style>
    <Style x:Key="MaximizeCaptionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Ts.CaptionButton}">
        <Setter Property="ToolTip" Value="{local:Translate Maximize}" />
        <Setter Property="AutomationProperties.Name" Value="{local:Translate Maximize}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="ToolTip" Value="{local:Translate Restore}" />
                <Setter Property="AutomationProperties.Name" Value="{local:Translate Restore}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
